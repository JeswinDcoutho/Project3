stage('Determine Active Color') {

    steps {

        withCredentials([
            [
                $class: 'AmazonWebServicesCredentialsBinding',
                credentialsId: 'aws-terraform-user'
            ]
        ]) {

            script {

                sh '''
                    set -e

                    echo "=============================================="
                    echo "DETERMINE ACTIVE COLOR"
                    echo "=============================================="

                    echo ""
                    echo "Current user-service-bg selector:"

                    kubectl get service "${USER_SERVICE_BG}" \
                        -n "${NAMESPACE}" \
                        -o jsonpath='{.spec.selector}' || true

                    echo ""
                '''

                def activeColor = sh(
                    script: '''
                        kubectl get service "${USER_SERVICE_BG}" \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.selector.version}' \
                            2>/dev/null || true
                    ''',
                    returnStdout: true
                ).trim()

                echo "Detected service color: '${activeColor}'"

                if (activeColor == 'blue') {

                    env.CURRENT_COLOR = 'blue'
                    env.TARGET_COLOR = 'green'

                }
                else if (activeColor == 'green') {

                    env.CURRENT_COLOR = 'green'
                    env.TARGET_COLOR = 'blue'

                }
                else {

                    echo "No valid service color detected."

                    def blueExists = sh(
                        script: '''
                            kubectl get deployment user-service-blue \
                                -n "${NAMESPACE}" \
                                >/dev/null 2>&1
                        ''',
                        returnStatus: true
                    )

                    def greenExists = sh(
                        script: '''
                            kubectl get deployment user-service-green \
                                -n "${NAMESPACE}" \
                                >/dev/null 2>&1
                        ''',
                        returnStatus: true
                    )

                    if (blueExists == 0 && greenExists != 0) {

                        env.CURRENT_COLOR = 'blue'
                        env.TARGET_COLOR = 'green'

                    }
                    else if (greenExists == 0 && blueExists != 0) {

                        env.CURRENT_COLOR = 'green'
                        env.TARGET_COLOR = 'blue'

                    }
                    else {

                        // First deployment.
                        // Deploy blue first.
                        env.CURRENT_COLOR = 'green'
                        env.TARGET_COLOR = 'blue'
                    }
                }

                echo ""
                echo "=============================================="
                echo "BLUE/GREEN STATE"
                echo "=============================================="
                echo "Current color : ${env.CURRENT_COLOR}"
                echo "Target color  : ${env.TARGET_COLOR}"
                echo "=============================================="

                if (env.CURRENT_COLOR == 'unknown' ||
                    env.TARGET_COLOR == 'unknown' ||
                    !env.CURRENT_COLOR ||
                    !env.TARGET_COLOR) {

                    error(
                        "Blue/Green state initialization failed. " +
                        "CURRENT_COLOR=${env.CURRENT_COLOR}, " +
                        "TARGET_COLOR=${env.TARGET_COLOR}"
                    )
                }
            }
        }
    }
}
