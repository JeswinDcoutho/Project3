pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        AWS_REGION   = 'ap-south-1'
        AWS_ACCOUNT  = '777000838263'
        ECR_REGISTRY = '777000838263.dkr.ecr.ap-south-1.amazonaws.com'
        EKS_CLUSTER  = 'ecommerce-eks'
        NAMESPACE    = 'nodejs-devops'

        USER_SERVICE = 'user-service'
        USER_REPO    = 'ecommerce-user-service'

        // Jenkins BUILD_NUMBER becomes the Docker image tag.
        IMAGE_TAG = "${BUILD_NUMBER}"

        GIT_REPO   = 'https://github.com/JeswinDcoutho/Project3.git'
        GIT_BRANCH = 'master'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "*/${GIT_BRANCH}"]],
                    doGenerateSubmoduleConfigurations: false,
                    extensions: [],
                    userRemoteConfigs: [[
                        credentialsId: 'github',
                        url: "${GIT_REPO}"
                    ]]
                ])

                sh '''
                    set -e

                    echo "=============================================="
                    echo "USER-SERVICE ONLY PIPELINE"
                    echo "=============================================="
                    echo "Jenkins build : ${BUILD_NUMBER}"
                    echo "Image tag     : ${IMAGE_TAG}"
                    echo "Git commit    : $(git rev-parse --short HEAD)"
                    echo "=============================================="
                '''
            }
        }

        stage('AWS Login') {
            steps {
                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-terraform-user'
                    ]
                ]) {
                    sh '''
                        set -e

                        echo "Configuring AWS credentials..."
                        aws sts get-caller-identity

                        echo "Configuring EKS kubeconfig..."
                        aws eks update-kubeconfig \
                          --name "${EKS_CLUSTER}" \
                          --region "${AWS_REGION}"

                        echo "Logging in to ECR..."
                        aws ecr get-login-password \
                          --region "${AWS_REGION}" | \
                          docker login \
                          --username AWS \
                          --password-stdin "${ECR_REGISTRY}"

                        echo "Current Kubernetes context:"
                        kubectl config current-context

                        echo "Checking namespace:"
                        kubectl get namespace "${NAMESPACE}"
                    '''
                }
            }
        }

        stage('Build user-service Image') {
            steps {
                sh '''
                    set -e

                    echo "=============================================="
                    echo "BUILDING ONLY USER-SERVICE"
                    echo "=============================================="

                    docker build \
                      -t "${ECR_REGISTRY}/${USER_REPO}:${IMAGE_TAG}" \
                      ./user-service

                    echo
                    echo "Image built successfully:"
                    docker images \
                      "${ECR_REGISTRY}/${USER_REPO}:${IMAGE_TAG}"
                '''
            }
        }

        stage('Push user-service Image') {
            steps {
                sh '''
                    set -e

                    echo "=============================================="
                    echo "PUSHING ONLY USER-SERVICE"
                    echo "=============================================="

                    docker push \
                      "${ECR_REGISTRY}/${USER_REPO}:${IMAGE_TAG}"

                    echo
                    echo "Verifying ECR image:"

                    aws ecr describe-images \
                      --repository-name "${USER_REPO}" \
                      --image-ids imageTag="${IMAGE_TAG}" \
                      --region "${AWS_REGION}" \
                      --query 'imageDetails[0].{tag:imageTags[0],digest:imageDigest}' \
                      --output table
                '''
            }
        }

        stage('Determine Active Color') {
            steps {
                script {

                    def activeColor = sh(
                        script: '''
                            set -e

                            kubectl get service user-service-bg \
                              -n "${NAMESPACE}" \
                              -o jsonpath='{.spec.selector.version}'
                        ''',
                        returnStdout: true
                    ).trim()

                    if (activeColor != 'blue' && activeColor != 'green') {
                        error(
                            "Unable to determine active user-service color: '${activeColor}'"
                        )
                    }

                    def targetColor =
                        (activeColor == 'blue') ? 'green' : 'blue'

                    env.CURRENT_COLOR = activeColor
                    env.TARGET_COLOR  = targetColor

                    echo "=============================================="
                    echo "USER-SERVICE BLUE/GREEN"
                    echo "=============================================="
                    echo "Current color : ${env.CURRENT_COLOR}"
                    echo "Target color  : ${env.TARGET_COLOR}"
                    echo "=============================================="
                }
            }
        }

        stage('Prepare Blue-Green Target') {
            steps {
                sh '''
                    set -e

                    TARGET_DEPLOYMENT="user-service-${TARGET_COLOR}"
                    TARGET_MANIFEST="k8s/user-service-${TARGET_COLOR}.yaml"

                    echo "=============================================="
                    echo "PREPARING TARGET COLOR"
                    echo "=============================================="
                    echo "Target deployment : ${TARGET_DEPLOYMENT}"
                    echo "Target manifest   : ${TARGET_MANIFEST}"
                    echo "Image             : ${ECR_REGISTRY}/${USER_REPO}:${IMAGE_TAG}"
                    echo "=============================================="

                    echo
                    echo "Clearing stale target replicas..."

                    kubectl scale deployment "${TARGET_DEPLOYMENT}" \
                      -n "${NAMESPACE}" \
                      --replicas=0 \
                      || true

                    echo
                    echo "Applying target manifest..."

                    kubectl apply \
                      -f "${TARGET_MANIFEST}" \
                      -n "${NAMESPACE}"

                    echo
                    echo "Setting Jenkins build image..."

                    kubectl set image \
                      deployment/"${TARGET_DEPLOYMENT}" \
                      "${USER_SERVICE}=${ECR_REGISTRY}/${USER_REPO}:${IMAGE_TAG}" \
                      -n "${NAMESPACE}"

                    echo
                    echo "Starting one target replica..."

                    kubectl scale deployment "${TARGET_DEPLOYMENT}" \
                      -n "${NAMESPACE}" \
                      --replicas=1

                    echo
                    echo "Target deployment:"
                    kubectl get deployment "${TARGET_DEPLOYMENT}" \
                      -n "${NAMESPACE}" \
                      -o wide
                '''
            }
        }

        stage('Wait for Target') {
            steps {
                sh '''
                    set -e

                    TARGET_DEPLOYMENT="user-service-${TARGET_COLOR}"

                    echo "=============================================="
                    echo "WAITING FOR TARGET ROLLOUT"
                    echo "=============================================="

                    kubectl rollout status \
                      deployment/"${TARGET_DEPLOYMENT}" \
                      -n "${NAMESPACE}" \
                      --timeout=5m

                    echo
                    echo "Target pods:"

                    kubectl get pods \
                      -n "${NAMESPACE}" \
                      -l "app=user-service,version=${TARGET_COLOR}" \
                      -o wide

                    echo
                    echo "Target deployment:"

                    kubectl get deployment "${TARGET_DEPLOYMENT}" \
                      -n "${NAMESPACE}"
                '''
            }
        }

        stage('Switch Traffic') {
            steps {
                sh '''
                    set -e

                    echo "=============================================="
                    echo "SWITCHING USER-SERVICE TRAFFIC"
                    echo "=============================================="
                    echo "${CURRENT_COLOR} -> ${TARGET_COLOR}"
                    echo "=============================================="

                    kubectl patch service user-service-bg \
                      -n "${NAMESPACE}" \
                      --type=merge \
                      -p "{\"spec\":{\"selector\":{\"app\":\"user-service\",\"version\":\"${TARGET_COLOR}\"}}}"

                    echo
                    echo "New service selector:"

                    kubectl get service user-service-bg \
                      -n "${NAMESPACE}" \
                      -o jsonpath='{.spec.selector}'

                    echo
                '''
            }
        }

        stage('Apply CPU-only HPA') {
            steps {
                sh '''
                    set -e

                    TARGET_DEPLOYMENT="user-service-${TARGET_COLOR}"

                    echo "=============================================="
                    echo "APPLYING USER-SERVICE HPA"
                    echo "=============================================="

                    kubectl apply \
                      -f k8s/user-service-hpa.yaml \
                      -n "${NAMESPACE}"

                    echo
                    echo "Retargeting HPA to:"
                    echo "${TARGET_DEPLOYMENT}"

                    kubectl patch hpa user-service-hpa \
                      -n "${NAMESPACE}" \
                      --type=merge \
                      -p "{\"spec\":{\"scaleTargetRef\":{\"apiVersion\":\"apps/v1\",\"kind\":\"Deployment\",\"name\":\"${TARGET_DEPLOYMENT}\"}}}"

                    echo
                    echo "HPA status:"

                    kubectl get hpa user-service-hpa \
                      -n "${NAMESPACE}" \
                      -o wide

                    echo
                    echo "HPA target:"

                    kubectl get hpa user-service-hpa \
                      -n "${NAMESPACE}" \
                      -o jsonpath='{.spec.scaleTargetRef.name}'

                    echo
                '''
            }
        }

        stage('Deactivate Old Color') {
            steps {
                sh '''
                    set -e

                    OLD_DEPLOYMENT="user-service-${CURRENT_COLOR}"

                    echo "=============================================="
                    echo "DEACTIVATING OLD COLOR"
                    echo "=============================================="
                    echo "Old deployment: ${OLD_DEPLOYMENT}"
                    echo "=============================================="

                    kubectl scale deployment "${OLD_DEPLOYMENT}" \
                      -n "${NAMESPACE}" \
                      --replicas=0

                    echo
                    echo "Blue/Green state:"

                    kubectl get deployment \
                      user-service-blue \
                      user-service-green \
                      -n "${NAMESPACE}"
                '''
            }
        }

        stage('Final Verification') {
            steps {
                sh '''
                    set -e

                    echo
                    echo "=============================================="
                    echo "FINAL USER-SERVICE VERIFICATION"
                    echo "=============================================="

                    echo
                    echo "1. Service:"
                    kubectl get service user-service-bg \
                      -n "${NAMESPACE}" \
                      -o wide

                    echo
                    echo "2. Service selector:"
                    kubectl get service user-service-bg \
                      -n "${NAMESPACE}" \
                      -o jsonpath='{.spec.selector}'
                    echo

                    echo
                    echo "3. Blue/Green deployments:"
                    kubectl get deployment \
                      user-service-blue \
                      user-service-green \
                      -n "${NAMESPACE}"

                    echo
                    echo "4. User-service pods:"
                    kubectl get pods \
                      -n "${NAMESPACE}" \
                      -l app=user-service \
                      -o wide

                    echo
                    echo "5. HPA:"
                    kubectl get hpa user-service-hpa \
                      -n "${NAMESPACE}" \
                      -o wide

                    echo
                    echo "6. HPA target:"
                    kubectl get hpa user-service-hpa \
                      -n "${NAMESPACE}" \
                      -o jsonpath='{.spec.scaleTargetRef.name}'
                    echo

                    echo
                    echo "7. Active deployment image:"
                    kubectl get deployment \
                      "user-service-${TARGET_COLOR}" \
                      -n "${NAMESPACE}" \
                      -o jsonpath='{.spec.template.spec.containers[0].image}'
                    echo

                    echo
                    echo "=============================================="
                    echo "USER-SERVICE VERIFICATION COMPLETE"
                    echo "=============================================="
                '''
            }
        }
    }

    post {

        success {
            echo """
==============================================
USER-SERVICE BLUE/GREEN + HPA SUCCESS
==============================================
Jenkins build : ${BUILD_NUMBER}
Image tag     : ${IMAGE_TAG}
Current color : ${env.CURRENT_COLOR}
Active color  : ${env.TARGET_COLOR}
HPA target    : user-service-${env.TARGET_COLOR}

Only user-service was built and deployed.

Other microservices were NOT:
- built
- pushed
- applied
- rolled out
- modified
==============================================
"""
        }

        failure {
            echo """
==============================================
USER-SERVICE PIPELINE FAILED
==============================================
Jenkins build : ${BUILD_NUMBER}
Image tag     : ${IMAGE_TAG}
Current color : ${env.CURRENT_COLOR}
Target color  : ${env.TARGET_COLOR}
==============================================
"""
        }

        always {
            sh '''
                docker logout "${ECR_REGISTRY}" >/dev/null 2>&1 || true
                docker image prune -f >/dev/null 2>&1 || true
            '''
        }
    }
}
