pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        AWS_REGION     = 'ap-south-1'
        EKS_CLUSTER    = 'ecommerce-eks'
        NAMESPACE      = 'nodejs-devops'

        ECR_REGISTRY   = '777000838263.dkr.ecr.ap-south-1.amazonaws.com'
        ECR_REPOSITORY = 'ecommerce-user-service'

        IMAGE_TAG      = "${BUILD_NUMBER}"
    }

    stages {

        // ============================================================
        // CHECKOUT
        // ============================================================

        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/master']],
                    userRemoteConfigs: [[
                        url: 'https://github.com/JeswinDcoutho/Project3.git',
                        credentialsId: 'github'
                    ]]
                ])

                sh '''
                    set -e

                    echo "=============================================="
                    echo "CHECKED OUT SOURCE"
                    echo "=============================================="

                    git rev-parse --short HEAD
                    git log -1 --oneline
                '''
            }
        }

        // ============================================================
        // INITIALIZE BLUE/GREEN STATE
        // ============================================================

        stage('Initialize Blue-Green State') {
            steps {
                script {
                    /*
                     * These are runtime variables.
                     * Do NOT put them in the top-level environment{} block.
                     */
                    env.CURRENT_COLOR = ''
                    env.TARGET_COLOR = ''
                    env.SMOKE_TEST_FAILED = 'false'
                    env.ROLLBACK_PERFORMED = 'false'

                    echo "Blue/Green state initialized."
                }
            }
        }

        // ============================================================
        // AWS LOGIN
        // ============================================================

        stage('AWS Login') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "AWS AUTHENTICATION"
                        echo "=============================================="

                        aws sts get-caller-identity

                        echo ""
                        echo "Configuring kubeconfig..."

                        aws eks update-kubeconfig \
                            --region "${AWS_REGION}" \
                            --name "${EKS_CLUSTER}"

                        echo ""
                        echo "Checking EKS nodes..."

                        kubectl get nodes -o wide

                        echo ""
                        echo "Checking namespace..."

                        kubectl get namespace "${NAMESPACE}"

                        echo ""
                        echo "Logging into ECR..."

                        aws ecr get-login-password \
                            --region "${AWS_REGION}" |
                        docker login \
                            --username AWS \
                            --password-stdin "${ECR_REGISTRY}"

                        echo ""
                        echo "AWS authentication completed."
                    '''
                }
            }
        }

        // ============================================================
        // BUILD USER SERVICE
        // ============================================================

        stage('Build user-service Image') {
            steps {
                sh '''
                    set -e

                    echo "=============================================="
                    echo "BUILDING USER-SERVICE IMAGE"
                    echo "=============================================="

                    cd user-service

                    docker build \
                        -t "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}" \
                        .

                    echo ""
                    echo "Image built:"

                    docker images \
                        "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"
                '''
            }
        }

        // ============================================================
        // PUSH USER SERVICE
        // ============================================================

        stage('Push user-service Image') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "PUSHING USER-SERVICE IMAGE"
                        echo "=============================================="

                        aws ecr get-login-password \
                            --region "${AWS_REGION}" |
                        docker login \
                            --username AWS \
                            --password-stdin "${ECR_REGISTRY}"

                        docker push \
                            "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"

                        echo ""
                        echo "Verifying image in ECR..."

                        aws ecr describe-images \
                            --repository-name "${ECR_REPOSITORY}" \
                            --image-ids imageTag="${IMAGE_TAG}" \
                            --region "${AWS_REGION}"

                        echo ""
                        echo "Image push and verification completed."
                    '''
                }
            }
        }

        // ============================================================
        // DATABASE SECRET
        // ============================================================

        stage('Ensure Database Secret') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user'],

                    [$class: 'UsernamePasswordMultiBinding',
                     credentialsId: 'rds-db-password',
                     usernameVariable: 'RDS_USER_UNUSED',
                     passwordVariable: 'RDS_PASSWORD']
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "ENSURING DATABASE SECRET"
                        echo "=============================================="

                        aws sts get-caller-identity >/dev/null

                        kubectl create secret generic ecommerce-db-secret \
                            -n "${NAMESPACE}" \
                            --from-literal=POSTGRES_HOST=ecommerce-postgres.c7u8o4skoxo.ap-south-1.rds.amazonaws.com \
                            --from-literal=POSTGRES_PORT=5432 \
                            --from-literal=POSTGRES_DB=ecommerce \
                            --from-literal=POSTGRES_USER=postgres \
                            --from-literal=POSTGRES_PASSWORD="${RDS_PASSWORD}" \
                            --dry-run=client \
                            -o yaml |
                        kubectl apply -f -

                        echo ""
                        echo "Database secret status:"

                        kubectl get secret ecommerce-db-secret \
                            -n "${NAMESPACE}"
                    '''
                }
            }
        }

        // ============================================================
        // DETERMINE ACTIVE COLOR
        // ============================================================

        stage('Determine Active Color') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    script {

                        def detectedColor = sh(
                            script: '''
                                set -e

                                kubectl get service user-service-bg \
                                    -n "${NAMESPACE}" \
                                    -o go-template='{{index .spec.selector "version"}}'
                            ''',
                            returnStdout: true
                        ).trim()

                        echo "Detected color: '${detectedColor}'"

                        if (detectedColor == 'blue') {

                            env.CURRENT_COLOR = 'blue'
                            env.TARGET_COLOR = 'green'

                        } else if (detectedColor == 'green') {

                            env.CURRENT_COLOR = 'green'
                            env.TARGET_COLOR = 'blue'

                        } else {

                            error(
                                "Invalid active color detected: '${detectedColor}'"
                            )
                        }

                        echo "Current color : ${env.CURRENT_COLOR}"
                        echo "Target color  : ${env.TARGET_COLOR}"

                        if (!env.CURRENT_COLOR ||
                            !env.TARGET_COLOR) {

                            error(
                                "Blue/Green variables were not initialized correctly. " +
                                "CURRENT_COLOR='${env.CURRENT_COLOR}', " +
                                "TARGET_COLOR='${env.TARGET_COLOR}'"
                            )
                        }

                        if (env.CURRENT_COLOR ==
                            env.TARGET_COLOR) {

                            error(
                                "Invalid Blue/Green state: current and target " +
                                "colors are identical."
                            )
                        }
                    }
                }
            }
        }

        // ============================================================
        // PREPARE TARGET
        // ============================================================

        stage('Prepare Blue-Green Target') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        TARGET_DEPLOYMENT="user-service-${TARGET_COLOR}"
                        TARGET_MANIFEST="k8s/user-service-${TARGET_COLOR}.yaml"

                        echo "=============================================="
                        echo "PREPARING BLUE-GREEN TARGET"
                        echo "=============================================="

                        echo "CURRENT_COLOR=${CURRENT_COLOR}"
                        echo "TARGET_COLOR=${TARGET_COLOR}"

                        echo "TARGET_DEPLOYMENT=${TARGET_DEPLOYMENT}"
                        echo "TARGET_MANIFEST=${TARGET_MANIFEST}"

                        if [ ! -f "${TARGET_MANIFEST}" ]; then
                            echo "ERROR: Manifest not found:"
                            echo "${TARGET_MANIFEST}"
                            exit 1
                        fi

                        echo ""
                        echo "Scaling target deployment to zero if it exists..."

                        if kubectl get deployment "${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" >/dev/null 2>&1; then

                            kubectl scale deployment "${TARGET_DEPLOYMENT}" \
                                -n "${NAMESPACE}" \
                                --replicas=0
                        else
                            echo "Target deployment does not exist yet."
                        fi

                        echo ""
                        echo "Applying target manifest..."

                        kubectl apply \
                            -f "${TARGET_MANIFEST}"

                        echo ""
                        echo "Updating target image..."

                        kubectl set image \
                            deployment/"${TARGET_DEPLOYMENT}" \
                            user-service="${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}" \
                            -n "${NAMESPACE}"

                        echo ""
                        echo "Scaling target deployment to 1..."

                        kubectl scale deployment "${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            --replicas=1

                        echo ""
                        echo "Blue/Green resources prepared."
                    '''
                }
            }
        }

        // ============================================================
        // WAIT FOR TARGET
        // ============================================================

        stage('Wait for Target') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        TARGET_DEPLOYMENT="user-service-${TARGET_COLOR}"

                        echo "=============================================="
                        echo "WAITING FOR TARGET"
                        echo "=============================================="

                        echo "Waiting for:"
                        echo "${TARGET_DEPLOYMENT}"

                        kubectl rollout status \
                            deployment/"${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            --timeout=180s

                        echo ""
                        echo "Target deployment status:"

                        kubectl get deployment "${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            -o wide

                        echo ""
                        echo "Target pods:"

                        kubectl get pods \
                            -n "${NAMESPACE}" \
                            -l app=user-service,version="${TARGET_COLOR}" \
                            -o wide
                    '''
                }
            }
        }

        // ============================================================
        // SWITCH TRAFFIC
        // ============================================================

        stage('Switch Traffic') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "SWITCHING TRAFFIC"
                        echo "=============================================="

                        echo "Switching:"
                        echo "${CURRENT_COLOR} -> ${TARGET_COLOR}"

                        kubectl patch service user-service-bg \
                            -n "${NAMESPACE}" \
                            -p "{\"spec\":{\"selector\":{\"app\":\"user-service\",\"version\":\"${TARGET_COLOR}\"}}}"

                        echo ""
                        echo "New service selector:"

                        kubectl get service user-service-bg \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.selector}'

                        echo ""

                        ACTIVE_COLOR=$(kubectl get service user-service-bg \
                            -n "${NAMESPACE}" \
                            -o go-template='{{index .spec.selector "version"}}')

                        if [ "${ACTIVE_COLOR}" != "${TARGET_COLOR}" ]; then
                            echo "ERROR: Traffic switch failed."
                            echo "Expected: ${TARGET_COLOR}"
                            echo "Actual:   ${ACTIVE_COLOR}"
                            exit 1
                        fi

                        echo "Traffic successfully switched to ${TARGET_COLOR}."
                    '''
                }
            }
        }

        // ============================================================
        // APPLY CPU-ONLY HPA
        // ============================================================

        stage('Apply CPU-only HPA') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        TARGET_DEPLOYMENT="user-service-${TARGET_COLOR}"

                        echo "=============================================="
                        echo "APPLYING CPU-ONLY HPA"
                        echo "=============================================="

                        cat <<EOF | kubectl apply -f -
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: user-service-hpa
  namespace: ${NAMESPACE}
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: ${TARGET_DEPLOYMENT}

  minReplicas: 1
  maxReplicas: 2

  behavior:
    scaleUp:
      stabilizationWindowSeconds: 0
      selectPolicy: Max
      policies:
        - type: Percent
          value: 100
          periodSeconds: 60

    scaleDown:
      stabilizationWindowSeconds: 300
      selectPolicy: Max
      policies:
        - type: Percent
          value: 50
          periodSeconds: 60

  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70
EOF

                        echo ""
                        echo "HPA applied."

                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}"

                        echo ""
                        echo "HPA target:"

                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.scaleTargetRef.name}'

                        echo ""

                        if [ "$(kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.scaleTargetRef.name}')" \
                            != "${TARGET_DEPLOYMENT}" ]; then

                            echo "ERROR: HPA target is incorrect."
                            exit 1
                        fi

                        echo ""
                        echo "CPU-only HPA configured successfully."
                    '''
                }
            }
        }

        // ============================================================
        // SMOKE TEST
        // ============================================================

        stage('Smoke Test Active Color') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    script {

                        def smokeStatus = sh(
                            script: '''
                                set +e

                                echo "=============================================="
                                echo "SMOKE TEST ACTIVE COLOR"
                                echo "=============================================="

                                echo "Testing active color:"
                                echo "${TARGET_COLOR}"

                                kubectl run user-service-smoke-test \
                                    -n "${NAMESPACE}" \
                                    --rm \
                                    --restart=Never \
                                    --image=curlimages/curl:8.10.1 \
                                    -- \
                                    curl \
                                    --fail \
                                    --silent \
                                    --show-error \
                                    --max-time 10 \
                                    http://user-service-bg:8001/docs

                                STATUS=$?

                                echo ""
                                echo "Smoke test exit code: ${STATUS}"

                                exit ${STATUS}
                            ''',
                            returnStatus: true
                        )

                        if (smokeStatus == 0) {

                            echo "Smoke test PASSED."

                            env.SMOKE_TEST_FAILED = 'false'

                        } else {

                            echo "Smoke test FAILED."

                            env.SMOKE_TEST_FAILED = 'true'

                            echo ""
                            echo "=============================================="
                            echo "SMOKE TEST FAILURE DETECTED"
                            echo "=============================================="
                            echo ""
                            echo "Traffic is currently on ${env.TARGET_COLOR}."
                            echo "Rollback will be attempted."
                        }
                    }
                }
            }
        }

        // ============================================================
        // ROLLBACK
        // ============================================================

        stage('Rollback Blue-Green') {
            when {
                expression {
                    return env.SMOKE_TEST_FAILED == 'true'
                }
            }

            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    script {

                        sh '''
                            set -e

                            OLD_DEPLOYMENT="user-service-${CURRENT_COLOR}"
                            FAILED_DEPLOYMENT="user-service-${TARGET_COLOR}"

                            echo ""
                            echo "============================================================"
                            echo "ROLLING BACK BLUE-GREEN DEPLOYMENT"
                            echo "============================================================"
                            echo ""

                            echo "${TARGET_COLOR^^} DID NOT PASS THE SMOKE TEST."
                            echo "ROLLING BACK TO ${CURRENT_COLOR^^}"
                            echo ""

                            echo "Old deployment:"
                            echo "${OLD_DEPLOYMENT}"

                            echo "Failed deployment:"
                            echo "${FAILED_DEPLOYMENT}"

                            echo ""
                            echo "Restoring old deployment..."

                            if ! kubectl get deployment "${OLD_DEPLOYMENT}" \
                                -n "${NAMESPACE}" >/dev/null 2>&1; then

                                echo "ERROR: Old deployment does not exist."
                                exit 1
                            fi

                            kubectl scale deployment "${OLD_DEPLOYMENT}" \
                                -n "${NAMESPACE}" \
                                --replicas=1

                            kubectl rollout status \
                                deployment/"${OLD_DEPLOYMENT}" \
                                -n "${NAMESPACE}" \
                                --timeout=180s

                            echo ""
                            echo "Restoring service traffic..."

                            kubectl patch service user-service-bg \
                                -n "${NAMESPACE}" \
                                -p "{\"spec\":{\"selector\":{\"app\":\"user-service\",\"version\":\"${CURRENT_COLOR}\"}}}"

                            echo ""
                            echo "Restoring HPA target..."

                            kubectl patch hpa user-service-hpa \
                                -n "${NAMESPACE}" \
                                --type='merge' \
                                -p "{\"spec\":{\"scaleTargetRef\":{\"apiVersion\":\"apps/v1\",\"kind\":\"Deployment\",\"name\":\"${OLD_DEPLOYMENT}\"}}}"

                            echo ""
                            echo "Scaling failed deployment to zero..."

                            if kubectl get deployment "${FAILED_DEPLOYMENT}" \
                                -n "${NAMESPACE}" >/dev/null 2>&1; then

                                kubectl scale deployment "${FAILED_DEPLOYMENT}" \
                                    -n "${NAMESPACE}" \
                                    --replicas=0
                            fi

                            echo ""
                            echo "Verifying rollback..."

                            ACTIVE_COLOR=$(kubectl get service user-service-bg \
                                -n "${NAMESPACE}" \
                                -o go-template='{{index .spec.selector "version"}}')

                            HPA_TARGET=$(kubectl get hpa user-service-hpa \
                                -n "${NAMESPACE}" \
                                -o jsonpath='{.spec.scaleTargetRef.name}')

                            echo "Service color : ${ACTIVE_COLOR}"
                            echo "HPA target    : ${HPA_TARGET}"

                            if [ "${ACTIVE_COLOR}" != "${CURRENT_COLOR}" ]; then
                                echo "ERROR: Service rollback failed."
                                exit 1
                            fi

                            if [ "${HPA_TARGET}" != "${OLD_DEPLOYMENT}" ]; then
                                echo "ERROR: HPA rollback failed."
                                exit 1
                            fi

                            echo ""
                            echo "============================================================"
                            echo "ROLLBACK COMPLETED SUCCESSFULLY"
                            echo "============================================================"
                            echo ""
                            echo "Traffic restored to: ${CURRENT_COLOR}"
                            echo "HPA restored to:     ${OLD_DEPLOYMENT}"
                            echo "Failed color scaled: ${TARGET_COLOR} -> 0"
                            echo ""
                        '''

                        env.ROLLBACK_PERFORMED = 'true'
                    }
                }
            }
        }

        // ============================================================
        // FINALIZE SUCCESSFUL DEPLOYMENT
        // ============================================================

        stage('Finalize Blue-Green Deployment') {
            when {
                expression {
                    return env.SMOKE_TEST_FAILED != 'true'
                }
            }

            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        OLD_DEPLOYMENT="user-service-${CURRENT_COLOR}"
                        NEW_DEPLOYMENT="user-service-${TARGET_COLOR}"

                        echo "=============================================="
                        echo "FINALIZING BLUE-GREEN DEPLOYMENT"
                        echo "=============================================="

                        echo "Active deployment:"
                        echo "${NEW_DEPLOYMENT}"

                        echo ""
                        echo "Deactivating old deployment:"

                        if kubectl get deployment "${OLD_DEPLOYMENT}" \
                            -n "${NAMESPACE}" >/dev/null 2>&1; then

                            kubectl scale deployment "${OLD_DEPLOYMENT}" \
                                -n "${NAMESPACE}" \
                                --replicas=0

                            echo "Old deployment scaled to 0."

                        else

                            echo "Old deployment does not exist."

                        fi

                        echo ""
                        echo "Current user-service deployments:"

                        kubectl get deployments \
                            -n "${NAMESPACE}" \
                            -l app=user-service \
                            -o wide

                        echo ""
                        echo "Blue-Green deployment finalized."
                    '''
                }
            }
        }

        // ============================================================
        // FINAL VERIFICATION
        // ============================================================

        stage('Final Verification') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        if [ "${SMOKE_TEST_FAILED}" = "true" ]; then
                            EXPECTED_COLOR="${CURRENT_COLOR}"
                        else
                            EXPECTED_COLOR="${TARGET_COLOR}"
                        fi

                        EXPECTED_DEPLOYMENT="user-service-${EXPECTED_COLOR}"

                        echo "============================================================"
                        echo "FINAL VERIFICATION"
                        echo "============================================================"

                        echo "Expected active color:"
                        echo "${EXPECTED_COLOR}"

                        echo ""
                        echo "Service selector:"

                        kubectl get service user-service-bg \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.selector}'

                        echo ""

                        ACTIVE_COLOR=$(kubectl get service user-service-bg \
                            -n "${NAMESPACE}" \
                            -o go-template='{{index .spec.selector "version"}}')

                        echo "Detected service color:"
                        echo "${ACTIVE_COLOR}"

                        if [ "${ACTIVE_COLOR}" != "${EXPECTED_COLOR}" ]; then
                            echo "ERROR: Final service color is incorrect."
                            exit 1
                        fi

                        echo ""
                        echo "HPA:"

                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}"

                        HPA_TARGET=$(kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.scaleTargetRef.name}')

                        echo ""
                        echo "HPA target:"
                        echo "${HPA_TARGET}"

                        if [ "${HPA_TARGET}" != "${EXPECTED_DEPLOYMENT}" ]; then
                            echo "ERROR: HPA target is incorrect."
                            exit 1
                        fi

                        echo ""
                        echo "Deployment:"

                        kubectl get deployment "${EXPECTED_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            -o wide

                        echo ""
                        echo "Pods:"

                        kubectl get pods \
                            -n "${NAMESPACE}" \
                            -l app=user-service,version="${EXPECTED_COLOR}" \
                            -o wide

                        echo ""
                        echo "============================================================"
                        echo "FINAL VERIFICATION PASSED"
                        echo "============================================================"
                    '''
                }
            }
        }
    }

    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {
            echo """
============================================================
JENKINS BUILD SUCCESS
============================================================

Current color       : ${env.CURRENT_COLOR}
Target color        : ${env.TARGET_COLOR}
Smoke test failed   : ${env.SMOKE_TEST_FAILED}
Rollback performed  : ${env.ROLLBACK_PERFORMED}
Image tag           : ${env.IMAGE_TAG}

============================================================
"""
        }

        failure {
            echo """
============================================================
JENKINS BUILD FAILED
============================================================

Current color       : ${env.CURRENT_COLOR}
Target color        : ${env.TARGET_COLOR}
Smoke test failed   : ${env.SMOKE_TEST_FAILED}
Rollback performed  : ${env.ROLLBACK_PERFORMED}
Image tag           : ${env.IMAGE_TAG}

If failure occurred during rollback, manual
investigation of Kubernetes state is required.

============================================================
"""
        }

        always {
            sh '''
                echo ""
                echo "================================================"
                echo "CLEANUP"
                echo "================================================"

                docker logout "${ECR_REGISTRY}" || true
                docker image prune -f || true

                echo ""
                echo "Cleanup completed."
            '''
        }
    }
}
