pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    environment {
        AWS_REGION       = 'ap-south-1'
        EKS_CLUSTER      = 'ecommerce-eks'
        NAMESPACE        = 'nodejs-devops'

        AWS_ACCOUNT_ID   = '777000838263'
        ECR_REGISTRY     = '777000838263.dkr.ecr.ap-south-1.amazonaws.com'
        ECR_REPOSITORY   = 'ecommerce-user-service'

        IMAGE_TAG        = "${BUILD_NUMBER}"

        CURRENT_COLOR    = 'unknown'
        TARGET_COLOR     = 'unknown'

        SMOKE_TEST_FAILED = 'false'
        ROLLBACK_PERFORMED = 'false'
    }

    stages {

        // ============================================================
        // 1. CHECKOUT
        // ============================================================
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/master']],
                    userRemoteConfigs: [[
                        url: 'https://github.com/JeswinDcoutho/Project3.git',
                        credentialsId: 'github'
                    ]]
                ])

                sh '''
                    set -e

                    echo "=========================================="
                    echo "GIT COMMIT"
                    echo "=========================================="

                    git rev-parse HEAD

                    echo ""
                    git log -1 --pretty=%B
                '''
            }
        }

        // ============================================================
        // 2. AWS LOGIN + EKS
        // ============================================================
        stage('AWS Login') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=========================================="
                        echo "AWS ACCOUNT"
                        echo "=========================================="

                        aws sts get-caller-identity

                        echo ""
                        echo "=========================================="
                        echo "EKS KUBECONFIG"
                        echo "=========================================="

                        aws eks update-kubeconfig \
                            --region "${AWS_REGION}" \
                            --name "${EKS_CLUSTER}"

                        echo ""
                        echo "=========================================="
                        echo "EKS NODES"
                        echo "=========================================="

                        kubectl get nodes -o wide

                        echo ""
                        echo "=========================================="
                        echo "APPLICATION NAMESPACE"
                        echo "=========================================="

                        kubectl get all -n "${NAMESPACE}" || true
                    '''
                }
            }
        }

        // ============================================================
        // 3. BUILD USER SERVICE
        // ============================================================
        stage('Build user-service Image') {
            steps {
                sh '''
                    set -e

                    echo "=========================================="
                    echo "BUILD USER SERVICE IMAGE"
                    echo "=========================================="

                    docker build \
                        -t "${ECR_REPOSITORY}:${IMAGE_TAG}" \
                        ./user-service

                    echo ""
                    echo "Docker image created:"
                    docker images "${ECR_REPOSITORY}:${IMAGE_TAG}"
                '''
            }
        }

        // ============================================================
        // 4. PUSH TO ECR
        // ============================================================
        stage('Push user-service Image') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=========================================="
                        echo "ECR LOGIN"
                        echo "=========================================="

                        aws ecr get-login-password \
                            --region "${AWS_REGION}" \
                            | docker login \
                            --username AWS \
                            --password-stdin "${ECR_REGISTRY}"

                        echo ""
                        echo "=========================================="
                        echo "TAG IMAGE"
                        echo "=========================================="

                        docker tag \
                            "${ECR_REPOSITORY}:${IMAGE_TAG}" \
                            "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"

                        echo ""
                        echo "=========================================="
                        echo "PUSH IMAGE"
                        echo "=========================================="

                        docker push \
                            "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"

                        echo ""
                        echo "=========================================="
                        echo "VERIFY IMAGE"
                        echo "=========================================="

                        aws ecr describe-images \
                            --repository-name "${ECR_REPOSITORY}" \
                            --image-ids imageTag="${IMAGE_TAG}" \
                            --region "${AWS_REGION}"
                    '''
                }
            }
        }

        // ============================================================
        // 5. DATABASE SECRET
        // ============================================================
        stage('Ensure Database Secret') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user'],

                    string(
                        credentialsId: 'rds-db-password',
                        variable: 'RDS_DB_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "=========================================="
                        echo "DATABASE SECRET"
                        echo "=========================================="

                        kubectl create secret generic ecommerce-db-secret \
                            -n "${NAMESPACE}" \
                            --from-literal=POSTGRES_USER=postgres \
                            --from-literal=POSTGRES_PASSWORD="${RDS_DB_PASSWORD}" \
                            --from-literal=POSTGRES_DB=ecommerce \
                            --from-literal=POSTGRES_HOST=ecommerce-postgres.c7u8o4skoxo.ap-south-1.rds.amazonaws.com \
                            --from-literal=POSTGRES_PORT=5432 \
                            --dry-run=client \
                            -o yaml \
                            | kubectl apply -f -

                        echo ""
                        kubectl get secret ecommerce-db-secret \
                            -n "${NAMESPACE}"
                    '''
                }
            }
        }

        // ============================================================
        // 6. DETERMINE ACTIVE COLOR
        // ============================================================
        stage('Determine Active Color') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    script {

                        echo "=========================================="
                        echo "DETERMINE ACTIVE COLOR"
                        echo "=========================================="

                        def detectedColor = sh(
                            script: '''
                                set -e

                                kubectl get service user-service-bg \
                                    -n "${NAMESPACE}" \
                                    -o go-template='{{index .spec.selector "version"}}'
                            ''',
                            returnStdout: true
                        ).trim()

                        echo "Detected color: '${detectedColor}'"

                        if (detectedColor == 'blue') {

                            env.CURRENT_COLOR = 'blue'
                            env.TARGET_COLOR = 'green'

                        } else if (detectedColor == 'green') {

                            env.CURRENT_COLOR = 'green'
                            env.TARGET_COLOR = 'blue'

                        } else {

                            error(
                                "Invalid or empty active color: '${detectedColor}'. " +
                                "Expected blue or green."
                            )
                        }

                        echo ""
                        echo "Current color : ${env.CURRENT_COLOR}"
                        echo "Target color  : ${env.TARGET_COLOR}"
                    }
                }
            }
        }

        // ============================================================
        // 7. PREPARE TARGET
        // ============================================================
        stage('Prepare Blue-Green Target') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        TARGET_DEPLOYMENT="user-service-${TARGET_COLOR}"
                        TARGET_MANIFEST="k8s/user-service-${TARGET_COLOR}.yaml"

                        echo "=========================================="
                        echo "PREPARE BLUE/GREEN TARGET"
                        echo "=========================================="

                        echo "Current color : ${CURRENT_COLOR}"
                        echo "Target color  : ${TARGET_COLOR}"

                        if [ ! -f "${TARGET_MANIFEST}" ]; then
                            echo "ERROR: ${TARGET_MANIFEST} does not exist."
                            exit 1
                        fi

                        echo ""
                        echo "Scaling target to zero first..."

                        if kubectl get deployment "${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" >/dev/null 2>&1; then

                            kubectl scale deployment "${TARGET_DEPLOYMENT}" \
                                -n "${NAMESPACE}" \
                                --replicas=0
                        fi

                        echo ""
                        echo "Applying target manifest..."

                        kubectl apply \
                            -f "${TARGET_MANIFEST}"

                        echo ""
                        echo "Setting image..."

                        kubectl set image \
                            deployment/"${TARGET_DEPLOYMENT}" \
                            user-service="${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}" \
                            -n "${NAMESPACE}"

                        echo ""
                        echo "Starting target with one replica..."

                        kubectl scale deployment "${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            --replicas=1

                        echo ""
                        kubectl get deployment "${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            -o wide
                    '''
                }
            }
        }

        // ============================================================
        // 8. WAIT FOR TARGET
        // ============================================================
        stage('Wait for Target') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        TARGET_DEPLOYMENT="user-service-${TARGET_COLOR}"

                        echo "=========================================="
                        echo "WAIT FOR TARGET ROLLOUT"
                        echo "=========================================="

                        kubectl rollout status \
                            deployment/"${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            --timeout=5m

                        echo ""
                        echo "=========================================="
                        echo "TARGET PODS"
                        echo "=========================================="

                        kubectl get pods \
                            -n "${NAMESPACE}" \
                            -l app=user-service,version="${TARGET_COLOR}" \
                            -o wide

                        echo ""
                        echo "Target rollout completed successfully."
                    '''
                }
            }
        }

        // ============================================================
        // 9. SWITCH TRAFFIC
        // ============================================================
        stage('Switch Traffic') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=========================================="
                        echo "SWITCH TRAFFIC"
                        echo "=========================================="

                        echo "Switching:"
                        echo "${CURRENT_COLOR} -> ${TARGET_COLOR}"

                        echo ""
                        echo "BEFORE:"

                        kubectl get service user-service-bg \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.selector}'

                        echo ""

                        cat > /tmp/user-service-bg-patch.json <<EOF
{
  "spec": {
    "selector": {
      "app": "user-service",
      "version": "${TARGET_COLOR}"
    }
  }
}
EOF

                        kubectl patch service user-service-bg \
                            -n "${NAMESPACE}" \
                            --type=merge \
                            --patch-file=/tmp/user-service-bg-patch.json

                        echo ""
                        echo "AFTER:"

                        kubectl get service user-service-bg \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.selector}'

                        echo ""

                        ACTIVE_COLOR=$(kubectl get service user-service-bg \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.selector.version}')

                        if [ "${ACTIVE_COLOR}" != "${TARGET_COLOR}" ]; then
                            echo "ERROR: Traffic switch failed."
                            exit 1
                        fi

                        echo ""
                        echo "Traffic successfully switched to ${TARGET_COLOR}."
                    '''
                }
            }
        }

        // ============================================================
        // 10. APPLY HPA
        // ============================================================
        stage('Apply CPU-only HPA') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        TARGET_DEPLOYMENT="user-service-${TARGET_COLOR}"

                        echo "=========================================="
                        echo "APPLY CPU-ONLY HPA"
                        echo "=========================================="

                        kubectl apply \
                            -f k8s/user-hpa.yaml

                        cat > /tmp/user-hpa-patch.json <<EOF
{
  "spec": {
    "scaleTargetRef": {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "name": "${TARGET_DEPLOYMENT}"
    }
  }
}
EOF

                        kubectl patch hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            --type=merge \
                            --patch-file=/tmp/user-hpa-patch.json

                        echo ""
                        echo "HPA status:"

                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}"

                        echo ""
                        echo "HPA target:"

                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.scaleTargetRef.name}'

                        echo ""
                    '''
                }
            }
        }

        // ============================================================
        // 11. SMOKE TEST
        //
        // IMPORTANT:
        // We DO NOT fail Jenkins if the new color fails.
        //
        // Instead:
        //   SMOKE_TEST_FAILED=true
        //
        // Then the rollback stage runs.
        // ============================================================
        stage('Smoke Test Active Color') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    script {

                        echo "=========================================="
                        echo "SMOKE TEST ${env.TARGET_COLOR.toUpperCase()}"
                        echo "=========================================="

                        def smokeResult = sh(
                            script: '''
                                set +e

                                echo "Testing active color: ${TARGET_COLOR}"

                                echo ""
                                echo "Active pods:"

                                kubectl get pods \
                                    -n "${NAMESPACE}" \
                                    -l app=user-service,version="${TARGET_COLOR}" \
                                    -o wide

                                echo ""
                                echo "Service endpoints:"

                                kubectl get endpoints user-service-bg \
                                    -n "${NAMESPACE}" \
                                    -o wide

                                echo ""
                                echo "Finding active pod..."

                                POD=$(kubectl get pods \
                                    -n "${NAMESPACE}" \
                                    -l app=user-service,version="${TARGET_COLOR}" \
                                    -o jsonpath='{.items[0].metadata.name}')

                                if [ -z "${POD}" ]; then
                                    echo "No active pod found."
                                    exit 1
                                fi

                                echo "Testing pod: ${POD}"

                                kubectl exec \
                                    -n "${NAMESPACE}" \
                                    "${POD}" \
                                    -- python -c "import urllib.request; print(urllib.request.urlopen('http://127.0.0.1:8001/docs', timeout=10).status)"

                                RESULT=$?

                                if [ ${RESULT} -eq 0 ]; then
                                    echo ""
                                    echo "Smoke test PASSED."
                                else
                                    echo ""
                                    echo "Smoke test FAILED."
                                fi

                                exit ${RESULT}
                            ''',
                            returnStatus: true
                        )

                        if (smokeResult != 0) {

                            env.SMOKE_TEST_FAILED = 'true'

                            echo ""
                            echo "================================================"
                            echo "GREEN DID NOT PASS THE SMOKE TEST"
                            echo "ROLLING BACK TO ${env.CURRENT_COLOR.toUpperCase()}"
                            echo "================================================"

                        } else {

                            env.SMOKE_TEST_FAILED = 'false'

                            echo ""
                            echo "================================================"
                            echo "${env.TARGET_COLOR.toUpperCase()} PASSED THE SMOKE TEST"
                            echo "CONTINUING DEPLOYMENT"
                            echo "================================================"
                        }
                    }
                }
            }
        }

        // ============================================================
        // 12. ROLLBACK
        //
        // Runs only when the new color failed.
        // ============================================================
        stage('Rollback Blue-Green') {
            when {
                expression {
                    env.SMOKE_TEST_FAILED == 'true'
                }
            }

            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        OLD_DEPLOYMENT="user-service-${CURRENT_COLOR}"
                        FAILED_DEPLOYMENT="user-service-${TARGET_COLOR}"

                        echo "================================================"
                        echo "AUTOMATIC BLUE/GREEN ROLLBACK"
                        echo "================================================"

                        echo ""
                        echo "Failed color : ${TARGET_COLOR}"
                        echo "Rollback to  : ${CURRENT_COLOR}"

                        echo ""
                        echo "1. Restore old deployment..."

                        kubectl scale deployment "${OLD_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            --replicas=1

                        echo ""
                        echo "2. Wait for old deployment..."

                        kubectl rollout status \
                            deployment/"${OLD_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            --timeout=5m

                        echo ""
                        echo "3. Switch Service back to old color..."

                        cat > /tmp/user-service-bg-rollback.json <<EOF
{
  "spec": {
    "selector": {
      "app": "user-service",
      "version": "${CURRENT_COLOR}"
    }
  }
}
EOF

                        kubectl patch service user-service-bg \
                            -n "${NAMESPACE}" \
                            --type=merge \
                            --patch-file=/tmp/user-service-bg-rollback.json

                        echo ""
                        echo "4. Restore HPA target..."

                        cat > /tmp/user-hpa-rollback.json <<EOF
{
  "spec": {
    "scaleTargetRef": {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "name": "${OLD_DEPLOYMENT}"
    }
  }
}
EOF

                        kubectl patch hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            --type=merge \
                            --patch-file=/tmp/user-hpa-rollback.json

                        echo ""
                        echo "5. Scale failed deployment down..."

                        if kubectl get deployment "${FAILED_DEPLOYMENT}" \
                            -n "${NAMESPACE}" >/dev/null 2>&1; then

                            kubectl scale deployment "${FAILED_DEPLOYMENT}" \
                                -n "${NAMESPACE}" \
                                --replicas=0
                        fi

                        echo ""
                        echo "================================================"
                        echo "VERIFYING ROLLBACK"
                        echo "================================================"

                        ACTIVE_COLOR=$(kubectl get service user-service-bg \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.selector.version}')

                        echo "Service now points to: ${ACTIVE_COLOR}"

                        if [ "${ACTIVE_COLOR}" != "${CURRENT_COLOR}" ]; then
                            echo ""
                            echo "ERROR: ROLLBACK FAILED."
                            echo "Service is not pointing back to ${CURRENT_COLOR}."
                            exit 1
                        fi

                        HPA_TARGET=$(kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.scaleTargetRef.name}')

                        echo "HPA now targets: ${HPA_TARGET}"

                        if [ "${HPA_TARGET}" != "${OLD_DEPLOYMENT}" ]; then
                            echo ""
                            echo "ERROR: HPA rollback failed."
                            exit 1
                        fi

                        echo ""
                        echo "================================================"
                        echo "ROLLBACK SUCCESSFUL"
                        echo "================================================"

                        echo ""
                        echo "Green did not pass."
                        echo "Traffic was rolled back to ${CURRENT_COLOR}."
                        echo "HPA restored to ${OLD_DEPLOYMENT}."
                        echo "Blue/previous version is LIVE."
                    '''

                    script {
                        env.ROLLBACK_PERFORMED = 'true'
                    }
                }
            }
        }

        // ============================================================
        // 13. FINALIZE SUCCESS
        //
        // Only runs when smoke test passed.
        // ============================================================
        stage('Finalize Blue-Green Deployment') {
            when {
                expression {
                    env.SMOKE_TEST_FAILED != 'true'
                }
            }

            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        OLD_DEPLOYMENT="user-service-${CURRENT_COLOR}"
                        ACTIVE_DEPLOYMENT="user-service-${TARGET_COLOR}"

                        echo "=========================================="
                        echo "FINALIZE BLUE/GREEN DEPLOYMENT"
                        echo "=========================================="

                        echo "New color passed smoke testing."
                        echo ""
                        echo "Active deployment : ${ACTIVE_DEPLOYMENT}"
                        echo "Old deployment    : ${OLD_DEPLOYMENT}"

                        echo ""
                        echo "Scaling old deployment to zero..."

                        if kubectl get deployment "${OLD_DEPLOYMENT}" \
                            -n "${NAMESPACE}" >/dev/null 2>&1; then

                            kubectl scale deployment "${OLD_DEPLOYMENT}" \
                                -n "${NAMESPACE}" \
                                --replicas=0
                        fi

                        echo ""
                        echo "Old color deactivated."
                    '''
                }
            }
        }

        // ============================================================
        // 14. FINAL VERIFICATION
        // ============================================================
        stage('Final Verification') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=========================================="
                        echo "FINAL VERIFICATION"
                        echo "=========================================="

                        if [ "${SMOKE_TEST_FAILED}" = "true" ]; then

                            EXPECTED_COLOR="${CURRENT_COLOR}"
                            EXPECTED_DEPLOYMENT="user-service-${CURRENT_COLOR}"

                        else

                            EXPECTED_COLOR="${TARGET_COLOR}"
                            EXPECTED_DEPLOYMENT="user-service-${TARGET_COLOR}"

                        fi

                        echo ""
                        echo "Expected active color : ${EXPECTED_COLOR}"
                        echo "Expected deployment   : ${EXPECTED_DEPLOYMENT}"

                        echo ""
                        echo "=========================================="
                        echo "SERVICE"
                        echo "=========================================="

                        kubectl get service user-service-bg \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.selector}'

                        echo ""

                        ACTIVE_SERVICE_COLOR=$(kubectl get service user-service-bg \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.selector.version}')

                        echo "Service active color: ${ACTIVE_SERVICE_COLOR}"

                        if [ "${ACTIVE_SERVICE_COLOR}" != "${EXPECTED_COLOR}" ]; then
                            echo "ERROR: Service is not pointing to expected color."
                            exit 1
                        fi

                        echo ""
                        echo "=========================================="
                        echo "DEPLOYMENTS"
                        echo "=========================================="

                        kubectl get deployments \
                            -n "${NAMESPACE}" \
                            -l app=user-service \
                            -o wide

                        echo ""
                        echo "=========================================="
                        echo "PODS"
                        echo "=========================================="

                        kubectl get pods \
                            -n "${NAMESPACE}" \
                            -l app=user-service \
                            -o wide

                        echo ""
                        echo "=========================================="
                        echo "HPA"
                        echo "=========================================="

                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}"

                        HPA_TARGET=$(kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.scaleTargetRef.name}')

                        echo ""
                        echo "HPA target: ${HPA_TARGET}"

                        if [ "${HPA_TARGET}" != "${EXPECTED_DEPLOYMENT}" ]; then
                            echo "ERROR: HPA does not target expected deployment."
                            exit 1
                        fi

                        echo ""
                        echo "=========================================="
                        echo "FINAL RESULT"
                        echo "=========================================="

                        if [ "${SMOKE_TEST_FAILED}" = "true" ]; then

                            echo ""
                            echo "GREEN DID NOT PASS."
                            echo "ROLLBACK WAS SUCCESSFUL."
                            echo "TRAFFIC IS RUNNING ON ${CURRENT_COLOR^^}."
                            echo "BUILD COMPLETED WITH ROLLBACK."

                        else

                            echo ""
                            echo "BLUE/GREEN DEPLOYMENT SUCCESSFUL."
                            echo "ACTIVE COLOR: ${TARGET_COLOR^^}"

                        fi
                    '''
                }
            }
        }
    }

    // ================================================================
    // POST
    // ================================================================
    post {

        success {
            script {

                if (env.ROLLBACK_PERFORMED == 'true') {

                    echo """
================================================
DEPLOYMENT COMPLETED WITH ROLLBACK
================================================

New color:
${env.TARGET_COLOR.toUpperCase()}

The new ${env.TARGET_COLOR.toUpperCase()} version did not pass the smoke test.

ROLLING BACK TO ${env.CURRENT_COLOR.toUpperCase()}...

Rollback completed successfully.

Traffic is now running on:
${env.CURRENT_COLOR.toUpperCase()}

Jenkins build completed successfully because
the previous stable version was restored.
================================================
"""

                } else {

                    echo """
================================================
BLUE/GREEN DEPLOYMENT SUCCESSFUL
================================================

Previous color:
${env.CURRENT_COLOR.toUpperCase()}

New active color:
${env.TARGET_COLOR.toUpperCase()}

Image:
${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:${env.IMAGE_TAG}

Smoke test:
PASSED

Traffic:
${env.TARGET_COLOR.toUpperCase()}

================================================
"""
                }
            }
        }

        failure {
            echo """
================================================
DEPLOYMENT FAILED
================================================

Current color:
${env.CURRENT_COLOR ?: 'unknown'}

Target color:
${env.TARGET_COLOR ?: 'unknown'}

If this happened during rollback, manual
investigation is required.
================================================
"""
        }

        always {
            withCredentials([
                [$class: 'AmazonWebServicesCredentialsBinding',
                 credentialsId: 'aws-terraform-user']
            ]) {
                sh '''
                    docker logout "${ECR_REGISTRY}" || true
                    docker image prune -f || true
                '''
            }
        }
    }
}
