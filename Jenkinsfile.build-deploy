pipeline {

    agent any

    environment {
        AWS_REGION = 'ap-south-1'
        EKS_CLUSTER = 'ecommerce-eks'
        NAMESPACE = 'nodejs-devops'

        AWS_ACCOUNT_ID = '777000838263'
        ECR_REGISTRY = '777000838263.dkr.ecr.ap-south-1.amazonaws.com'
        USER_IMAGE = 'ecommerce-user-service'

        RDS_HOST = 'ecommerce-postgres.c7u8o4skoxo.ap-south-1.rds.amazonaws.com'
        RDS_PORT = '5432'
        RDS_DB = 'ecommerce'
        RDS_USER = 'ecommerce'

        USER_SERVICE = 'user-service'
        USER_BG_SERVICE = 'user-service-bg'

        HPA_NAME = 'user-service-hpa'
        HPA_CPU_TARGET = '70'
        HPA_MIN_REPLICAS = '2'
        HPA_MAX_REPLICAS = '5'
    }

    stages {

        // ============================================================
        // CHECKOUT
        // ============================================================

        stage('Checkout') {
            steps {
                echo "=============================================="
                echo "CHECKOUT"
                echo "=============================================="

                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/master']],
                    userRemoteConfigs: [[
                        url: 'https://github.com/JeswinDcoutho/Project3.git',
                        credentialsId: 'github'
                    ]]
                ])

                sh '''
                    set -e

                    echo ""
                    echo "Git commit:"
                    git rev-parse HEAD

                    echo ""
                    echo "Git message:"
                    git log -1 --pretty=%B

                    echo ""
                    echo "User service:"
                    ls -la user-service/
                '''
            }
        }


        // ============================================================
        // INITIALIZE BLUE/GREEN STATE
        // ============================================================

        stage('Initialize Blue-Green State') {
            steps {
                script {

                    echo "=============================================="
                    echo "INITIALIZE BLUE/GREEN STATE"
                    echo "=============================================="

                    /*
                     * IMPORTANT:
                     *
                     * Do NOT define these in the top-level
                     * environment {} block.
                     *
                     * They are runtime state and are populated
                     * dynamically after Kubernetes is queried.
                     */

                    env.CURRENT_COLOR = ''
                    env.TARGET_COLOR = ''
                    env.INITIAL_DEPLOYMENT = 'false'
                    env.SMOKE_TEST_FAILED = 'false'
                    env.POST_SWITCH_FAILURE = 'false'
                    env.ROLLBACK_PERFORMED = 'false'
                    env.HPA_EXISTED_BEFORE_SWITCH = 'false'

                    echo "Blue/Green state initialized."
                    echo "CURRENT_COLOR=${env.CURRENT_COLOR}"
                    echo "TARGET_COLOR=${env.TARGET_COLOR}"
                }
            }
        }


        // ============================================================
        // AWS LOGIN
        // ============================================================

        stage('AWS Login') {
            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {

                    sh '''
                        set -e

                        echo "=============================================="
                        echo "AWS LOGIN"
                        echo "=============================================="
                        echo "=============================================="

                        aws sts get-caller-identity

                        echo ""
                        echo "Configuring EKS kubeconfig..."

                        aws eks update-kubeconfig \
                            --region "${AWS_REGION}" \
                            --name "${EKS_CLUSTER}"

                        echo ""
                        echo "EKS context:"
                        kubectl config current-context

                        echo ""
                        echo "Cluster connectivity:"
                        kubectl cluster-info
                    '''
                }
            }
        }


        // ============================================================
        // BUILD USER-SERVICE IMAGE
        // ============================================================

        stage('Build user-service Image') {
            steps {

                sh '''
                    set -e

                    echo "=============================================="
                    echo "BUILD USER-SERVICE IMAGE"
                    echo "=============================================="
                    echo "=============================================="

                    IMAGE="${ECR_REGISTRY}/${USER_IMAGE}:${BUILD_NUMBER}"

                    echo "Image:"
                    echo "${IMAGE}"

                    docker build \
                        -t "${IMAGE}" \
                        ./user-service

                    echo ""
                    echo "Docker image built successfully."

                    docker images "${ECR_REGISTRY}/${USER_IMAGE}" \
                        --format 'table {{.Repository}}\\t{{.Tag}}\\t{{.ID}}\\t{{.Size}}'
                '''
            }
        }


        // ============================================================
        // PUSH USER-SERVICE IMAGE
        // ============================================================

        stage('Push user-service Image') {
            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {

                    sh '''
                        set -e

                        echo "=============================================="
                        echo "PUSH USER-SERVICE IMAGE"
                        echo "=============================================="
                        echo "=============================================="

                        IMAGE="${ECR_REGISTRY}/${USER_IMAGE}:${BUILD_NUMBER}"

                        echo "Logging into ECR..."

                        aws ecr get-login-password \
                            --region "${AWS_REGION}" |
                        docker login \
                            --username AWS \
                            --password-stdin "${ECR_REGISTRY}"

                        echo ""
                        echo "Pushing image:"
                        echo "${IMAGE}"

                        docker push "${IMAGE}"

                        echo ""
                        echo "Verifying image in ECR..."

                        aws ecr describe-images \
                            --repository-name "${USER_IMAGE}" \
                            --image-ids imageTag="${BUILD_NUMBER}" \
                            --region "${AWS_REGION}"

                        echo ""
                        echo "ECR image verified successfully."
                    '''
                }
            }
        }


        // ============================================================
        // ENSURE DATABASE SECRET
        // ============================================================

        stage('Ensure Database Secret') {
            steps {

                withCredentials([

                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user'],

                    string(
                        credentialsId: 'rds-db-password',
                        variable: 'RDS_PASSWORD'
                    )

                ]) {

                    sh '''
                        set -e

                        echo "=============================================="
                        echo "ENSURING DATABASE SECRET"
                        echo "=============================================="
                        echo "=============================================="

                        aws sts get-caller-identity >/dev/null

                        kubectl create secret generic ecommerce-db-secret \
                            -n "${NAMESPACE}" \
                            --from-literal=POSTGRES_HOST="${RDS_HOST}" \
                            --from-literal=POSTGRES_PORT="${RDS_PORT}" \
                            --from-literal=POSTGRES_DB="${RDS_DB}" \
                            --from-literal=POSTGRES_USER="${RDS_USER}" \
                            --from-literal=POSTGRES_PASSWORD="${RDS_PASSWORD}" \
                            --dry-run=client \
                            -o yaml |
                        kubectl apply -f -

                        echo ""
                        echo "Database secret status:"

                        kubectl get secret ecommerce-db-secret \
                            -n "${NAMESPACE}"

                        echo ""
                        echo "Database secret ensured successfully."
                    '''
                }
            }
        }


        // ============================================================
        // DETERMINE ACTIVE COLOR
        // ============================================================

        stage('Determine Active Color') {
            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {

                    script {

                        echo "=============================================="
                        echo "DETERMINE ACTIVE COLOR"
                        echo "=============================================="
                        echo "=============================================="

                        sh '''
                            set -e

                            echo ""
                            echo "Current user-service-bg selector:"

                            kubectl get service "${USER_BG_SERVICE}" \
                                -n "${NAMESPACE}" \
                                -o jsonpath='{.spec.selector}' \
                                2>/dev/null || echo "user-service-bg does not exist yet."

                            echo
                        '''

                        def activeColor = sh(
                            script: '''
                                kubectl get service "${USER_BG_SERVICE}" \
                                    -n "${NAMESPACE}" \
                                    -o jsonpath='{.spec.selector.version}' \
                                    2>/dev/null || true
                            ''',
                            returnStdout: true
                        ).trim()

                        echo "Detected service color: '${activeColor}'"


                        // ------------------------------------------------
                        // NORMAL BLUE/GREEN SWITCH
                        // ------------------------------------------------

                        if (activeColor == 'blue') {

                            env.CURRENT_COLOR = 'blue'
                            env.TARGET_COLOR = 'green'

                        }
                        else if (activeColor == 'green') {

                            env.CURRENT_COLOR = 'green'
                            env.TARGET_COLOR = 'blue'

                        }

                        // ------------------------------------------------
                        // RECOVERY / INITIAL DEPLOYMENT LOGIC
                        // ------------------------------------------------

                        else {

                            echo "No valid active service color detected."

                            def blueExists = sh(
                                script: '''
                                    kubectl get deployment user-service-blue \
                                        -n "${NAMESPACE}" \
                                        >/dev/null 2>&1
                                ''',
                                returnStatus: true
                            ) == 0

                            def greenExists = sh(
                                script: '''
                                    kubectl get deployment user-service-green \
                                        -n "${NAMESPACE}" \
                                        >/dev/null 2>&1
                                ''',
                                returnStatus: true
                            ) == 0


                            if (blueExists && !greenExists) {

                                env.CURRENT_COLOR = 'blue'
                                env.TARGET_COLOR = 'green'

                            }
                            else if (greenExists && !blueExists) {

                                env.CURRENT_COLOR = 'green'
                                env.TARGET_COLOR = 'blue'

                            }
                            else {

                                /*
                                 * Initial deployment.
                                 *
                                 * No active color exists.
                                 * Deploy BLUE as the first color.
                                 */
                                env.CURRENT_COLOR = 'green'
                                env.TARGET_COLOR = 'blue'
                                env.INITIAL_DEPLOYMENT = 'true'
                            }
                        }


                        // ------------------------------------------------
                        // VALIDATE STATE
                        // ------------------------------------------------

                        echo ""
                        echo "=============================================="
                        echo "BLUE/GREEN STATE"
                        echo "=============================================="
                        echo "Current color : ${env.CURRENT_COLOR}"
                        echo "Target color  : ${env.TARGET_COLOR}"
                        echo "=============================================="


                        if (!env.CURRENT_COLOR ||
                            env.CURRENT_COLOR == 'unknown' ||
                            !env.TARGET_COLOR ||
                            env.TARGET_COLOR == 'unknown') {

                            error(
                                "Blue/Green state initialization failed. " +
                                "CURRENT_COLOR=${env.CURRENT_COLOR}, " +
                                "TARGET_COLOR=${env.TARGET_COLOR}"
                            )
                        }
                    }
                }
            }
        }


        // ============================================================
        // PREPARE BLUE/GREEN
        // ============================================================

        stage('Prepare Blue-Green') {
            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {

                    sh '''
                        set -e

                        echo "=============================================="
                        echo "PREPARE BLUE/GREEN"
                        echo "=============================================="
                        echo "=============================================="

                        TARGET_DEPLOYMENT="user-service-${TARGET_COLOR}"
                        TARGET_MANIFEST="k8s/user-service-${TARGET_COLOR}.yaml"

                        IMAGE="${ECR_REGISTRY}/${USER_IMAGE}:${BUILD_NUMBER}"

                        echo "Current color : ${CURRENT_COLOR}"
                        echo "Target color  : ${TARGET_COLOR}"

                        echo ""
                        echo "Target deployment:"
                        echo "${TARGET_DEPLOYMENT}"

                        echo ""
                        echo "Target manifest:"
                        echo "${TARGET_MANIFEST}"

                        echo ""
                        echo "Image:"
                        echo "${IMAGE}"


                        # ----------------------------------------------
                        # Ensure blue/green traffic service exists
                        # ----------------------------------------------

                        if kubectl get service "${USER_BG_SERVICE}" \
                            -n "${NAMESPACE}" >/dev/null 2>&1; then

                            echo ""
                            echo "Blue/Green service already exists."

                        else

                            echo ""
                            echo "Blue/Green service does not exist."
                            echo "Creating it from manifest..."

                            kubectl apply \
                                -f k8s/user-service-bg-service.yaml

                        fi


                        # ----------------------------------------------
                        # Ensure target deployment exists
                        # ----------------------------------------------

                        if kubectl get deployment "${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" >/dev/null 2>&1; then

                            echo ""
                            echo "Existing target deployment found."

                            kubectl scale deployment "${TARGET_DEPLOYMENT}" \
                                -n "${NAMESPACE}" \
                                --replicas=0

                        else

                            echo ""
                            echo "Target deployment does not exist."
                            echo "Creating it from manifest..."

                            kubectl apply \
                                -f "${TARGET_MANIFEST}"

                        fi


                        # ----------------------------------------------
                        # Force the requested image
                        # ----------------------------------------------

                        echo ""
                        echo "Updating target image..."

                        kubectl set image \
                            deployment/"${TARGET_DEPLOYMENT}" \
                            user-service="${IMAGE}" \
                            -n "${NAMESPACE}"


                        # ----------------------------------------------
                        # Ensure image is always pulled
                        # ----------------------------------------------

                        echo ""
                        echo "Setting imagePullPolicy=Always..."

                        kubectl patch deployment "${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            --type='strategic' \
                            -p '{"spec":{"template":{"spec":{"containers":[{"name":"user-service","imagePullPolicy":"Always"}]}}}}'


                        # ----------------------------------------------
                        # Start target deployment
                        # ----------------------------------------------

                        echo ""
                        echo "Scaling target deployment to 1 replica..."

                        kubectl scale deployment "${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            --replicas=1


                        echo ""
                        echo "Target deployment prepared."

                        kubectl get deployment "${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            -o wide

                    '''
                }
            }
        }


        // ============================================================
        // WAIT FOR TARGET
        // ============================================================

        stage('Wait for Target') {
            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {

                    sh '''
                        set -e

                        echo "=============================================="
                        echo "WAIT FOR TARGET"
                        echo "=============================================="
                        echo "=============================================="

                        TARGET_DEPLOYMENT="user-service-${TARGET_COLOR}"

                        echo "Waiting for deployment:"
                        echo "${TARGET_DEPLOYMENT}"

                        kubectl rollout status \
                            deployment/"${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            --timeout=180s

                        echo ""
                        echo "Target deployment rollout successful."

                        kubectl get pods \
                            -n "${NAMESPACE}" \
                            -l app=user-service,version="${TARGET_COLOR}" \
                            -o wide

                        echo ""
                        echo "Target pod status:"

                        kubectl get pods \
                            -n "${NAMESPACE}" \
                            -l app=user-service,version="${TARGET_COLOR}"
                    '''
                }
            }
        }


        // ============================================================
        // SWITCH TRAFFIC
        // ============================================================

        stage('Switch Traffic') {
            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {

                    sh '''
                        set -e

                        echo "=============================================="
                        echo "SWITCH TRAFFIC"
                        echo "=============================================="
                        echo "=============================================="

                        echo "Previous color:"
                        echo "${CURRENT_COLOR}"

                        echo "New color:"
                        echo "${TARGET_COLOR}"

                        echo ""
                        echo "Patching service selector..."

                        kubectl patch service "${USER_BG_SERVICE}" \
                            -n "${NAMESPACE}" \
                            --type='merge' \
                            -p "{\"spec\":{\"selector\":{\"app\":\"user-service\",\"version\":\"${TARGET_COLOR}\"}}}"


                        echo ""
                        echo "New service selector:"

                        kubectl get service "${USER_BG_SERVICE}" \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.selector}'

                        echo

                        echo ""
                        echo "Traffic successfully switched to ${TARGET_COLOR}."
                    '''
                }
            }
        }


        // ============================================================
        // APPLY CPU-ONLY HPA
        // ============================================================

        stage('Apply CPU-only HPA') {
            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {

                    script {

                        env.HPA_EXISTED_BEFORE_SWITCH =
                            sh(
                                script: '''
                                    kubectl get hpa "${HPA_NAME}" \
                                        -n "${NAMESPACE}" >/dev/null 2>&1
                                ''',
                                returnStatus: true
                            ) == 0 ? 'true' : 'false'

                        echo "HPA existed before switch: ${env.HPA_EXISTED_BEFORE_SWITCH}"

                        def hpaResult = sh(
                            script: '''
                                set -e

                                echo "=============================================="
                                echo "APPLY CPU-ONLY HPA"
                                echo "=============================================="

                                TARGET_DEPLOYMENT="user-service-${TARGET_COLOR}"

                                echo "HPA target:"
                                echo "${TARGET_DEPLOYMENT}"

                                cat > /tmp/user-service-hpa.yaml <<EOF
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: ${HPA_NAME}
  namespace: ${NAMESPACE}
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: ${TARGET_DEPLOYMENT}

  minReplicas: ${HPA_MIN_REPLICAS}
  maxReplicas: ${HPA_MAX_REPLICAS}

  behavior:
    scaleUp:
      stabilizationWindowSeconds: 0
      selectPolicy: Max
      policies:
        - type: Percent
          value: 100
          periodSeconds: 60

    scaleDown:
      stabilizationWindowSeconds: 300
      selectPolicy: Max
      policies:
        - type: Percent
          value: 50
          periodSeconds: 60

  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: ${HPA_CPU_TARGET}
EOF

                                kubectl apply                                     -f /tmp/user-service-hpa.yaml

                                echo ""
                                echo "HPA configured successfully."

                                kubectl get hpa "${HPA_NAME}" \
                                    -n "${NAMESPACE}"

                                echo ""
                                echo "HPA YAML:"

                                kubectl get hpa "${HPA_NAME}" \
                                    -n "${NAMESPACE}" \
                                        -o yaml
                            ''',
                            returnStatus: true
                        )

                        if (hpaResult == 0) {
                            echo "HPA applied successfully."
                        } else {
                            echo "HPA application failed."
                            echo "POST_SWITCH_FAILURE=true - automatic rollback will be attempted."
                            env.POST_SWITCH_FAILURE = 'true'
                        }
                    }
                }
            }
        }


        // ============================================================
        // SMOKE TEST
        // ============================================================

        stage('Smoke Test') {
            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {

                    script {

                        echo "=============================================="
                        echo "SMOKE TEST"
                        echo "=============================================="
                        echo "=============================================="

                        def smokeResult = sh(
                            script: '''
                                set +e

                                TARGET_DEPLOYMENT="user-service-${TARGET_COLOR}"

                                echo "Testing deployment:"
                                echo "${TARGET_DEPLOYMENT}"

                                POD=$(kubectl get pods \
                                    -n "${NAMESPACE}" \
                                    -l app=user-service,version="${TARGET_COLOR}" \
                                    -o jsonpath='{.items[0].metadata.name}')

                                echo ""
                                echo "Smoke test pod:"
                                echo "${POD}"

                                if [ -z "${POD}" ]; then
                                    echo "ERROR: No target pod was found for smoke testing."
                                    exit 1
                                fi

                                echo ""
                                echo "Testing /health ..."

                                kubectl exec \
                                    -n "${NAMESPACE}" \
                                    "${POD}" \
                                    -- sh -c 'curl -fsS http://127.0.0.1:8001/health'

                                if [ $? -eq 0 ]; then
                                    echo ""
                                    echo "Health endpoint succeeded."
                                    exit 0
                                fi


                                echo ""
                                echo "/health failed."
                                echo "Testing /healthz ..."

                                kubectl exec \
                                    -n "${NAMESPACE}" \
                                    "${POD}" \
                                    -- sh -c 'curl -fsS http://127.0.0.1:8001/healthz'

                                if [ $? -eq 0 ]; then
                                    echo ""
                                    echo "Healthz endpoint succeeded."
                                    exit 0
                                fi


                                echo ""
                                echo "/healthz failed."
                                echo "Testing root endpoint ..."

                                kubectl exec \
                                    -n "${NAMESPACE}" \
                                    "${POD}" \
                                    -- sh -c 'curl -fsS http://127.0.0.1:8001/'

                                if [ $? -eq 0 ]; then
                                    echo ""
                                    echo "Root endpoint succeeded."
                                    exit 0
                                fi


                                echo ""
                                echo "All smoke tests failed."
                                exit 1
                            ''',
                            returnStatus: true
                        )


                        if (smokeResult == 0) {

                            env.SMOKE_TEST_FAILED = 'false'

                            echo ""
                            echo "=============================================="
                            echo "SMOKE TEST PASSED"
                            echo "=============================================="

                        }
                        else {

                            env.SMOKE_TEST_FAILED = 'true'

                            echo ""
                            echo "=============================================="
                            echo "SMOKE TEST FAILED"
                            echo "=============================================="

                            echo "Automatic rollback will be attempted."
                        }
                    }
                }
            }
        }


        // ============================================================
        // FINAL HEALTH CHECKS
        // ============================================================

        stage('Final Health Checks') {
            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {

                    script {

                        def healthResult = sh(
                            script: '''
                                set -e

                                echo "=============================================="
                                echo "FINAL HEALTH CHECKS"
                                echo "=============================================="

                                echo "Expected active color:"
                                echo "${TARGET_COLOR}"


                                echo ""
                                echo "Service:"

                                kubectl get service "${USER_BG_SERVICE}" \
                                    -n "${NAMESPACE}" \
                                    -o wide


                                echo ""
                                echo "Service selector:"

                                kubectl get service "${USER_BG_SERVICE}" \
                                    -n "${NAMESPACE}" \
                                    -o jsonpath='{.spec.selector}'

                                echo


                                echo ""
                                echo "Active deployment:"

                                kubectl get deployment \
                                    "user-service-${TARGET_COLOR}" \
                                    -n "${NAMESPACE}" \
                                    -o wide


                                echo ""
                                echo "All user-service deployments:"

                                kubectl get deployments \
                                    -n "${NAMESPACE}" \
                                    -l app=user-service \
                                    -o wide


                                echo ""
                                echo "User-service pods:"

                                kubectl get pods \
                                    -n "${NAMESPACE}" \
                                    -l app=user-service \
                                    -o wide


                                echo ""
                                echo "HPA:"

                                kubectl get hpa "${HPA_NAME}" \
                                    -n "${NAMESPACE}" \
                                        -o wide


                                echo ""
                                echo "HPA target:"

                                kubectl get hpa "${HPA_NAME}" \
                                    -n "${NAMESPACE}" \
                                        -o jsonpath='{.spec.scaleTargetRef.name}'

                                echo


                                echo ""
                                echo "Verifying HPA target matches active deployment..."

                                HPA_TARGET=$(kubectl get hpa "${HPA_NAME}" \
                                    -n "${NAMESPACE}" \
                                        -o jsonpath='{.spec.scaleTargetRef.name}')

                                EXPECTED_TARGET="user-service-${TARGET_COLOR}"

                                if [ "${HPA_TARGET}" != "${EXPECTED_TARGET}" ]; then
                                    echo "ERROR: HPA target mismatch."
                                    echo "Expected: ${EXPECTED_TARGET}"
                                    echo "Actual:   ${HPA_TARGET}"
                                    exit 1
                                fi


                                echo ""
                                echo "Verifying service selector..."

                                SERVICE_VERSION=$(kubectl get service "${USER_BG_SERVICE}" \
                                    -n "${NAMESPACE}" \
                                    -o jsonpath='{.spec.selector.version}')

                                if [ "${SERVICE_VERSION}" != "${TARGET_COLOR}" ]; then
                                    echo "ERROR: Service selector mismatch."
                                    echo "Expected: ${TARGET_COLOR}"
                                    echo "Actual:   ${SERVICE_VERSION}"
                                    exit 1
                                fi


                                echo ""
                                echo "Final health checks completed successfully."
                            ''',
                            returnStatus: true
                        )

                        if (healthResult == 0) {

                            echo ""
                            echo "=============================================="
                            echo "FINAL HEALTH CHECKS PASSED"
                            echo "=============================================="

                        } else {

                            echo ""
                            echo "=============================================="
                            echo "FINAL HEALTH CHECKS FAILED"
                            echo "=============================================="

                            echo "POST_SWITCH_FAILURE=true - automatic rollback will be attempted."

                            env.POST_SWITCH_FAILURE = 'true'
                        }
                    }
                }
            }
        }


        // ============================================================
        // ROLLBACK ON FAILURE
        // ============================================================

        stage('Rollback on Failure') {
            when {
                expression {
                    return env.SMOKE_TEST_FAILED == 'true' ||
                           env.POST_SWITCH_FAILURE == 'true'
                }
            }

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {

                    script {

                        echo "=============================================="
                        echo "AUTOMATIC ROLLBACK"
                        echo "=============================================="
                        echo "=============================================="

                        def rollbackResult = sh(
                            script: '''
                                set -e

                                FAILED_DEPLOYMENT="user-service-${TARGET_COLOR}"
                                PREVIOUS_DEPLOYMENT="user-service-${CURRENT_COLOR}"

                                echo "Failed color       : ${TARGET_COLOR}"
                                echo "Previous color     : ${CURRENT_COLOR}"
                                echo "Initial deployment : ${INITIAL_DEPLOYMENT}"


                                # ------------------------------------------
                                # Initial deployment rollback
                                # ------------------------------------------

                                if [ "${INITIAL_DEPLOYMENT}" = "true" ]; then

                                    echo ""
                                    echo "Initial deployment failed."
                                    echo "There is no previous active color to restore."

                                    echo ""
                                    echo "Removing failed deployment..."

                                    if kubectl get deployment "${FAILED_DEPLOYMENT}" \
                                        -n "${NAMESPACE}" >/dev/null 2>&1; then

                                        kubectl delete deployment "${FAILED_DEPLOYMENT}" \
                                            -n "${NAMESPACE}" \
                                            --ignore-not-found

                                    fi


                                    echo ""
                                    echo "Removing HPA..."

                                    kubectl delete hpa "${HPA_NAME}" \
                                        -n "${NAMESPACE}" \
                                        --ignore-not-found


                                    echo ""
                                    echo "Removing blue/green service..."

                                    kubectl delete service "${USER_BG_SERVICE}" \
                                        -n "${NAMESPACE}" \
                                        --ignore-not-found


                                    echo ""
                                    echo "Verifying initial deployment cleanup..."

                                    if kubectl get deployment "${FAILED_DEPLOYMENT}" \
                                        -n "${NAMESPACE}" >/dev/null 2>&1; then

                                        echo "ERROR: Failed deployment still exists."
                                        exit 1

                                    fi


                                    if kubectl get service "${USER_BG_SERVICE}" \
                                        -n "${NAMESPACE}" >/dev/null 2>&1; then

                                        echo "ERROR: Blue/Green service still exists."
                                        exit 1

                                    fi


                                    echo ""
                                    echo "Initial deployment rollback cleanup completed successfully."

                                    exit 0
                                fi


                                # ------------------------------------------
                                # Normal blue/green rollback
                                # ------------------------------------------

                                echo ""
                                echo "Restoring service selector..."

                                kubectl patch service "${USER_BG_SERVICE}" \
                                    -n "${NAMESPACE}" \
                                    --type='merge' \
                                    -p "{\"spec\":{\"selector\":{\"app\":\"user-service\",\"version\":\"${CURRENT_COLOR}\"}}}"


                                echo ""
                                echo "Service selector after rollback:"

                                kubectl get service "${USER_BG_SERVICE}" \
                                    -n "${NAMESPACE}" \
                                    -o jsonpath='{.spec.selector}'

                                echo


                                # ------------------------------------------
                                # Restore HPA to previous color
                                # ------------------------------------------

                                if kubectl get deployment "${PREVIOUS_DEPLOYMENT}" \
                                    -n "${NAMESPACE}" >/dev/null 2>&1; then

                                    echo ""
                                    echo "Restoring HPA..."

                                    if [ "${HPA_EXISTED_BEFORE_SWITCH}" = "true" ]; then

                                        echo "Restoring HPA target to:"
                                        echo "${PREVIOUS_DEPLOYMENT}"

                                        kubectl patch hpa "${HPA_NAME}" \
                                            -n "${NAMESPACE}" \
                                            --type='merge' \
                                            -p "{\"spec\":{\"scaleTargetRef\":{\"apiVersion\":\"apps/v1\",\"kind\":\"Deployment\",\"name\":\"${PREVIOUS_DEPLOYMENT}\"}}}"

                                    else

                                        echo "No HPA existed before this deployment."
                                        echo "Removing HPA created by the failed deployment..."

                                        kubectl delete hpa "${HPA_NAME}" \
                                            -n "${NAMESPACE}" \
                                            --ignore-not-found

                                    fi

                                else

                                    echo ""
                                    echo "ERROR: Previous deployment does not exist."
                                    echo "Cannot safely restore the previous active color."
                                    exit 1

                                fi


                                # ------------------------------------------
                                # Scale failed deployment down
                                # ------------------------------------------

                                if kubectl get deployment "${FAILED_DEPLOYMENT}" \
                                    -n "${NAMESPACE}" >/dev/null 2>&1; then

                                    echo ""
                                    echo "Scaling failed deployment to zero:"

                                    kubectl scale deployment "${FAILED_DEPLOYMENT}" \
                                        -n "${NAMESPACE}" \
                                        --replicas=0

                                else

                                    echo ""
                                    echo "Failed deployment does not exist."

                                fi


                                # ------------------------------------------
                                # Verify rollback
                                # ------------------------------------------

                                echo ""
                                echo "Verifying service selector..."

                                ACTIVE_AFTER_ROLLBACK=$(kubectl get service "${USER_BG_SERVICE}" \
                                    -n "${NAMESPACE}" \
                                    -o jsonpath='{.spec.selector.version}')

                                echo "Active color after rollback:"
                                echo "${ACTIVE_AFTER_ROLLBACK}"

                                if [ "${ACTIVE_AFTER_ROLLBACK}" != "${CURRENT_COLOR}" ]; then
                                    echo ""
                                    echo "ERROR: Service rollback verification failed."
                                    exit 1
                                fi


                                echo ""
                                echo "Verifying HPA..."

                                HPA_TARGET_AFTER_ROLLBACK=$(kubectl get hpa "${HPA_NAME}" \
                                    -n "${NAMESPACE}" \
                                    -o jsonpath='{.spec.scaleTargetRef.name}')

                                echo "HPA target after rollback:"
                                echo "${HPA_TARGET_AFTER_ROLLBACK}"

                                if [ "${HPA_TARGET_AFTER_ROLLBACK}" != "${PREVIOUS_DEPLOYMENT}" ]; then
                                    echo ""
                                    echo "ERROR: HPA rollback verification failed."
                                    echo "Expected: ${PREVIOUS_DEPLOYMENT}"
                                    echo "Actual:   ${HPA_TARGET_AFTER_ROLLBACK}"
                                    exit 1
                                fi


                                echo ""
                                echo "Verifying deployments..."

                                kubectl get deployments \
                                    -n "${NAMESPACE}" \
                                    -l app=user-service \
                                    -o wide


                                echo ""
                                echo "Rollback completed successfully."
                            ''',
                            returnStatus: true
                        )


                        if (rollbackResult == 0) {

                            env.ROLLBACK_PERFORMED = 'true'

                            echo ""
                            echo "=============================================="
                            echo "ROLLBACK SUCCESSFUL"
                            echo "=============================================="

                            /*
                             * Important:
                             *
                             * Rollback is considered a controlled recovery.
                             * Jenkins remains SUCCESS if rollback succeeds.
                             */

                        }
                        else {

                            env.ROLLBACK_PERFORMED = 'false'

                            error(
                                "AUTOMATIC ROLLBACK FAILED. " +
                                "Manual intervention is required."
                            )
                        }
                    }
                }
            }
        }


        // ============================================================

        stage('Deactivate Old Color') {
            when {
                expression {
                    return env.SMOKE_TEST_FAILED != 'true' &&
                           env.POST_SWITCH_FAILURE != 'true'
                }
            }

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {

                    sh '''
                        set -e

                        echo "=============================================="
                        echo "DEACTIVATE OLD COLOR"
                        echo "=============================================="

                        OLD_DEPLOYMENT="user-service-${CURRENT_COLOR}"

                        echo "Current old color:"
                        echo "${CURRENT_COLOR}"

                        echo "New active color:"
                        echo "${TARGET_COLOR}"

                        echo ""
                        echo "Old deployment:"
                        echo "${OLD_DEPLOYMENT}"


                        if kubectl get deployment "${OLD_DEPLOYMENT}" \
                            -n "${NAMESPACE}" >/dev/null 2>&1; then

                            echo ""
                            echo "Scaling old deployment to zero..."

                            kubectl scale deployment "${OLD_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            --replicas=0

                            echo ""
                            echo "Old deployment scaled to zero."

                        else

                            echo ""
                            echo "Old deployment does not exist."
                            echo "Nothing to deactivate."

                        fi


                        echo ""
                        echo "Current user-service deployments:"

                        kubectl get deployments \
                            -n "${NAMESPACE}" \
                            -l app=user-service \
                            -o wide
                    '''
                }
            }
        }


        // ============================================================
        // DEPLOYMENT SUMMARY
        // ============================================================

        stage('Deployment Summary') {
            steps {

                echo ""
                echo "=============================================="
                echo "DEPLOYMENT SUMMARY"
                echo "=============================================="
                echo ""
                echo "Service         : user-service"
                echo "Deployment type : Blue/Green"
                echo "HPA             : CPU only"
                echo "CPU target      : ${HPA_CPU_TARGET}%"
                echo "HPA min         : ${HPA_MIN_REPLICAS}"
                echo "HPA max         : ${HPA_MAX_REPLICAS}"
                echo ""
                echo "Current color   : ${env.CURRENT_COLOR}"
                echo "Target color    : ${env.TARGET_COLOR}"
                echo "Smoke failed    : ${env.SMOKE_TEST_FAILED}"
                echo "Rollback        : ${env.ROLLBACK_PERFORMED}"
                echo ""
                echo "Image:"
                echo "${ECR_REGISTRY}/${USER_IMAGE}:${BUILD_NUMBER}"
                echo ""
                echo "=============================================="
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {
            echo ""
            echo "=============================================="
            echo "PIPELINE FINISHED"
            echo "=============================================="

            script {

                if (env.ROLLBACK_PERFORMED == 'true') {

                    echo ""
                    echo "JENKINS BUILD SUCCESSFUL"
                    echo ""
                    echo "Deployment failed smoke testing."
                    echo "Automatic rollback completed successfully."
                    echo "Previous color has been restored."

                }
                else {

                    echo ""
                    echo "JENKINS BUILD SUCCESSFUL"
                    echo ""
                    echo "Blue/Green deployment completed successfully."
                    echo "Traffic is serving the new color."
                }
            }
        }


        failure {
            echo ""
            echo "=============================================="
            echo "PIPELINE FINISHED"
            echo "=============================================="

            echo ""
            echo "JENKINS BUILD FAILED"
            echo ""
            echo "Review the stage above for the failure."
        }


        always {
            echo ""
            echo "=============================================="
            echo "BUILD INFORMATION"
            echo "=============================================="

            echo "Build number : ${BUILD_NUMBER}"
            echo "Job          : ${JOB_NAME}"
            echo "Build URL    : ${BUILD_URL}"

            echo "=============================================="
        }
    }
}
