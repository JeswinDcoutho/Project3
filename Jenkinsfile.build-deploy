pipeline {

    agent any

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    environment {
        AWS_REGION       = 'ap-south-1'
        EKS_CLUSTER      = 'ecommerce-eks'
        NAMESPACE        = 'nodejs-devops'

        AWS_ACCOUNT_ID   = '777000838263'
        ECR_REGISTRY     = '777000838263.dkr.ecr.ap-south-1.amazonaws.com'
        ECR_REPOSITORY   = 'ecommerce-user-service'

        IMAGE_TAG        = "${BUILD_NUMBER}"

        CURRENT_COLOR    = ''
        TARGET_COLOR     = ''
    }

    stages {

        // ============================================================
        // CHECKOUT
        // ============================================================

        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/master']],
                    userRemoteConfigs: [[
                        url: 'https://github.com/JeswinDcoutho/Project3.git',
                        credentialsId: 'github'
                    ]]
                ])

                sh '''
                    set -e

                    echo "=============================================="
                    echo "USER-SERVICE ONLY BLUE/GREEN PIPELINE"
                    echo "=============================================="

                    echo "Jenkins build : ${BUILD_NUMBER}"
                    echo "Image tag     : ${IMAGE_TAG}"
                    echo "Git branch    : ${GIT_BRANCH}"

                    echo "Git commit    : $(git rev-parse --short HEAD)"

                    echo "=============================================="
                '''
            }
        }


        // ============================================================
        // AWS LOGIN
        // ============================================================

        stage('AWS Login') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "AWS AUTHENTICATION"
                        echo "=============================================="

                        echo "AWS identity:"
                        aws sts get-caller-identity

                        echo
                        echo "Configuring EKS kubeconfig..."

                        aws eks update-kubeconfig \
                            --name "${EKS_CLUSTER}" \
                            --region "${AWS_REGION}"

                        echo
                        echo "Testing Kubernetes access..."

                        kubectl get nodes

                        echo
                        echo "Logging in to ECR..."

                        aws ecr get-login-password \
                            --region "${AWS_REGION}" \
                            | docker login \
                            --username AWS \
                            --password-stdin "${ECR_REGISTRY}"

                        echo
                        echo "AWS / EKS / ECR authentication successful."
                    '''
                }
            }
        }


        // ============================================================
        // BUILD USER-SERVICE IMAGE
        // ============================================================

        stage('Build user-service Image') {
            steps {
                sh '''
                    set -e

                    echo "=============================================="
                    echo "BUILDING USER-SERVICE ONLY"
                    echo "=============================================="

                    echo "Image:"
                    echo "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"

                    docker build \
                        -t "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}" \
                        ./user-service

                    echo
                    echo "Docker image created:"

                    docker images \
                        "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"
                '''
            }
        }


        // ============================================================
        // PUSH USER-SERVICE IMAGE
        // ============================================================

        stage('Push user-service Image') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "PUSHING USER-SERVICE ONLY"
                        echo "=============================================="

                        echo "Repository : ${ECR_REPOSITORY}"
                        echo "Image tag  : ${IMAGE_TAG}"

                        aws ecr get-login-password \
                            --region "${AWS_REGION}" \
                            | docker login \
                            --username AWS \
                            --password-stdin "${ECR_REGISTRY}"

                        docker push \
                            "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"

                        echo
                        echo "Verifying ECR image..."

                        aws ecr describe-images \
                            --repository-name "${ECR_REPOSITORY}" \
                            --image-ids imageTag="${IMAGE_TAG}" \
                            --region "${AWS_REGION}" \
                            --query 'imageDetails[0].{tag:imageTags[0],digest:imageDigest}' \
                            --output table

                        echo
                        echo "ECR verification successful."
                    '''
                }
            }
        }


        // ============================================================
        // DATABASE SECRET
        // ============================================================

        stage('Ensure Database Secret') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user'],

                    string(
                        credentialsId: 'rds-db-password',
                        variable: 'RDS_DB_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "ENSURING DATABASE SECRET"
                        echo "=============================================="

                        kubectl create secret generic ecommerce-db-secret \
                            -n "${NAMESPACE}" \
                            --from-literal=POSTGRES_USER=ecommerce \
                            --from-literal=POSTGRES_PASSWORD="${RDS_DB_PASSWORD}" \
                            --dry-run=client \
                            -o yaml \
                        | kubectl apply -f -

                        echo
                        echo "Database secret is ready."
                    '''
                }
            }
        }


        // ============================================================
        // DETERMINE ACTIVE COLOR
        // ============================================================

        stage('Determine Active Color') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    script {

                        def activeColor = sh(
                            script: '''
                                set -e

                                kubectl get service user-service-bg \
                                    -n "${NAMESPACE}" \
                                    -o jsonpath='{.spec.selector.version}'
                            ''',
                            returnStdout: true
                        ).trim()

                        if (activeColor != 'blue' && activeColor != 'green') {
                            error(
                                "Invalid active color '${activeColor}'. " +
                                "Expected blue or green."
                            )
                        }

                        env.CURRENT_COLOR = activeColor

                        if (activeColor == 'blue') {
                            env.TARGET_COLOR = 'green'
                        } else {
                            env.TARGET_COLOR = 'blue'
                        }

                        echo "=============================================="
                        echo "BLUE/GREEN COLOR DECISION"
                        echo "=============================================="
                        echo "Current color : ${env.CURRENT_COLOR}"
                        echo "Target color  : ${env.TARGET_COLOR}"
                        echo "=============================================="
                    }
                }
            }
        }


        // ============================================================
        // PREPARE TARGET COLOR
        // ============================================================

        stage('Prepare Blue-Green Target') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        TARGET_DEPLOYMENT="user-service-${TARGET_COLOR}"
                        TARGET_MANIFEST="k8s/user-service-${TARGET_COLOR}.yaml"

                        echo "=============================================="
                        echo "PREPARING BLUE/GREEN TARGET"
                        echo "=============================================="

                        echo "Current color : ${CURRENT_COLOR}"
                        echo "Target color  : ${TARGET_COLOR}"
                        echo "Deployment    : ${TARGET_DEPLOYMENT}"
                        echo "Manifest      : ${TARGET_MANIFEST}"

                        echo
                        echo "Checking whether target deployment exists..."

                        if kubectl get deployment "${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" >/dev/null 2>&1; then

                            echo "Target deployment exists."
                            echo "Scaling target deployment to zero..."

                            kubectl scale deployment "${TARGET_DEPLOYMENT}" \
                                -n "${NAMESPACE}" \
                                --replicas=0

                        else
                            echo "Target deployment does not exist."
                            echo "It will be created from the manifest."
                        fi

                        echo
                        echo "Applying target manifest..."

                        kubectl apply \
                            -f "${TARGET_MANIFEST}" \
                            -n "${NAMESPACE}"

                        echo
                        echo "Setting image..."

                        kubectl set image deployment/"${TARGET_DEPLOYMENT}" \
                            user-service="${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}" \
                            -n "${NAMESPACE}"

                        echo
                        echo "Scaling target deployment to 1..."

                        kubectl scale deployment "${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            --replicas=1

                        echo
                        echo "Target deployment configured."

                        kubectl get deployment "${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            -o wide
                    '''
                }
            }
        }


        // ============================================================
        // WAIT FOR TARGET
        // ============================================================

        stage('Wait for Target') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        TARGET_DEPLOYMENT="user-service-${TARGET_COLOR}"

                        echo "=============================================="
                        echo "WAITING FOR TARGET DEPLOYMENT"
                        echo "=============================================="

                        echo "Deployment:"
                        echo "${TARGET_DEPLOYMENT}"

                        echo
                        echo "Waiting for rollout..."

                        kubectl rollout status \
                            deployment/"${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            --timeout=300s

                        echo
                        echo "Target deployment is ready."

                        echo
                        echo "Target pods:"

                        kubectl get pods \
                            -n "${NAMESPACE}" \
                            -l app=user-service,version="${TARGET_COLOR}" \
                            -o wide

                        echo
                        echo "Target deployment:"

                        kubectl get deployment "${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            -o wide
                    '''
                }
            }
        }


        // ============================================================
        // SWITCH SERVICE TRAFFIC
        // ============================================================

        stage('Switch Traffic') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "SWITCHING BLUE/GREEN TRAFFIC"
                        echo "=============================================="

                        echo "Traffic:"
                        echo "  ${CURRENT_COLOR} -> ${TARGET_COLOR}"

                        cat > /tmp/user-service-bg-patch.json <<PATCH
{
  "spec": {
    "selector": {
      "app": "user-service",
      "version": "${TARGET_COLOR}"
    }
  }
}
PATCH

                        echo
                        echo "Applying service selector patch..."

                        kubectl patch service user-service-bg \
                            -n "${NAMESPACE}" \
                            --type=merge \
                            --patch-file=/tmp/user-service-bg-patch.json

                        rm -f /tmp/user-service-bg-patch.json

                        echo
                        echo "New service selector:"

                        kubectl get service user-service-bg \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.selector}'

                        echo
                        echo

                        echo "Traffic successfully switched to ${TARGET_COLOR}."
                    '''
                }
            }
        }


        // ============================================================
        // CPU-ONLY HPA
        // ============================================================

        stage('Apply CPU-only HPA') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        TARGET_DEPLOYMENT="user-service-${TARGET_COLOR}"

                        echo "=============================================="
                        echo "APPLYING CPU-ONLY HPA"
                        echo "=============================================="

                        echo "HPA target : ${TARGET_DEPLOYMENT}"
                        echo "CPU target : 70%"
                        echo "Min pods   : 1"
                        echo "Max pods   : 2"

                        echo
                        echo "Applying HPA manifest..."

                        kubectl apply \
                            -f k8s/user-hpa.yaml \
                            -n "${NAMESPACE}"

                        echo
                        echo "Retargeting HPA..."

                        cat > /tmp/user-service-hpa-patch.json <<PATCH
{
  "spec": {
    "scaleTargetRef": {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "name": "${TARGET_DEPLOYMENT}"
    }
  }
}
PATCH

                        kubectl patch hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            --type=merge \
                            --patch-file=/tmp/user-service-hpa-patch.json

                        rm -f /tmp/user-service-hpa-patch.json

                        echo
                        echo "HPA configuration:"

                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o wide

                        echo
                        echo "HPA target:"

                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.scaleTargetRef.name}'

                        echo
                        echo

                        echo "HPA metrics:"

                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.metrics}'

                        echo
                    '''
                }
            }
        }


        // ============================================================
        // DEACTIVATE OLD COLOR
        // ============================================================

        stage('Deactivate Old Color') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        OLD_DEPLOYMENT="user-service-${CURRENT_COLOR}"

                        echo "=============================================="
                        echo "DEACTIVATING OLD COLOR"
                        echo "=============================================="

                        echo "Old deployment:"
                        echo "${OLD_DEPLOYMENT}"

                        echo

                        if kubectl get deployment "${OLD_DEPLOYMENT}" \
                            -n "${NAMESPACE}" >/dev/null 2>&1; then

                            echo "Old deployment exists."
                            echo "Scaling old color to zero..."

                            kubectl scale deployment "${OLD_DEPLOYMENT}" \
                                -n "${NAMESPACE}" \
                                --replicas=0

                            echo "Old color scaled to zero."

                        else
                            echo "Old deployment does not exist."
                            echo "Nothing to deactivate."
                        fi

                        echo
                        echo "Blue/Green deployment state:"

                        kubectl get deployments \
                            -n "${NAMESPACE}" \
                            -l app=user-service \
                            -o wide
                    '''
                }
            }
        }


        // ============================================================
        // FINAL VERIFICATION
        // ============================================================

        stage('Final Verification') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "FINAL VERIFICATION"
                        echo "=============================================="

                        echo
                        echo "1. Service selector:"
                        kubectl get service user-service-bg \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.selector}'

                        echo
                        echo

                        echo "2. User-service deployments:"

                        kubectl get deployments \
                            -n "${NAMESPACE}" \
                            -l app=user-service \
                            -o wide

                        echo
                        echo "3. User-service pods:"

                        kubectl get pods \
                            -n "${NAMESPACE}" \
                            -l app=user-service \
                            -o wide

                        echo
                        echo "4. HPA:"

                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o wide

                        echo
                        echo "5. HPA target:"

                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.scaleTargetRef.name}'

                        echo
                        echo

                        echo "6. HPA metrics:"

                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.metrics}'

                        echo
                        echo

                        echo "7. Service endpoints:"

                        kubectl get endpoints user-service-bg \
                            -n "${NAMESPACE}" \
                            -o wide

                        echo
                        echo "=============================================="
                        echo "FINAL VERIFICATION SUCCESSFUL"
                        echo "=============================================="

                        echo "Active color : ${TARGET_COLOR}"
                        echo "Image tag    : ${IMAGE_TAG}"
                        echo "HPA target   : user-service-${TARGET_COLOR}"
                        echo "CPU target   : 70%"
                        echo "Min replicas : 1"
                        echo "Max replicas : 2"

                        echo "=============================================="
                    '''
                }
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        always {
            sh '''
                docker logout "${ECR_REGISTRY}" || true
                docker image prune -f || true
            '''
        }

        success {
            echo """
==============================================
USER-SERVICE PIPELINE SUCCESSFUL
==============================================

Jenkins build : ${BUILD_NUMBER}
Image tag     : ${IMAGE_TAG}

Current color : ${CURRENT_COLOR}
Target color  : ${TARGET_COLOR}

Active deployment:
user-service-${TARGET_COLOR}

HPA:
user-service-hpa

CPU target:
70%

Min replicas:
1

Max replicas:
2

Other services:
product-service = NOT TOUCHED
cart-service    = NOT TOUCHED
order-service   = NOT TOUCHED
payment-service = NOT TOUCHED
inventory-service = NOT TOUCHED

==============================================
"""
        }

        failure {
            echo """
==============================================
USER-SERVICE PIPELINE FAILED
==============================================

Jenkins build : ${BUILD_NUMBER}
Image tag     : ${IMAGE_TAG}

Current color : ${CURRENT_COLOR}
Target color  : ${TARGET_COLOR}

Check the failed stage above.

==============================================
"""
        }
    }
}

