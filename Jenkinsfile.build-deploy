pipeline {

    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    environment {

        // ============================================================
        // AWS / EKS
        // ============================================================

        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '777000838263'
        EKS_CLUSTER = 'ecommerce-eks'
        NAMESPACE = 'nodejs-devops'


        // ============================================================
        // ECR
        // ============================================================

        ECR_REGISTRY = '777000838263.dkr.ecr.ap-south-1.amazonaws.com'
        USER_IMAGE = 'ecommerce-user-service'


        // ============================================================
        // Git
        // ============================================================

        GIT_BRANCH = 'master'


        // ============================================================
        // Kubernetes
        // ============================================================

        USER_SERVICE = 'user-service'
        USER_SERVICE_BG = 'user-service-bg'


        // ============================================================
        // IMPORTANT:
        // Do NOT leave these empty.
        // They are changed later with env.CURRENT_COLOR and
        // env.TARGET_COLOR.
        // ============================================================

        CURRENT_COLOR = 'unknown'
        TARGET_COLOR = 'unknown'

        SMOKE_TEST_FAILED = 'false'
        ROLLBACK_PERFORMED = 'false'
    }


    stages {


        // ============================================================
        // CHECKOUT
        // ============================================================

        stage('Checkout') {

            steps {

                echo '=============================================='
                echo 'CHECKOUT'
                echo '=============================================='

                checkout([
                    $class: 'GitSCM',

                    branches: [[
                        name: "*/${GIT_BRANCH}"
                    ]],

                    userRemoteConfigs: [[
                        url: 'https://github.com/JeswinDcoutho/Project3.git',
                        credentialsId: 'github'
                    ]],

                    extensions: [
                        [$class: 'CleanBeforeCheckout']
                    ]
                ])

                sh '''
                    set -e

                    echo ""
                    echo "Git commit:"
                    git rev-parse HEAD

                    echo ""
                    echo "Git message:"
                    git log -1 --pretty=%B

                    echo ""
                    echo "User service:"
                    ls -la user-service/
                '''
            }
        }


        // ============================================================
        // INITIALIZE BLUE/GREEN STATE
        // ============================================================

        stage('Initialize Blue-Green State') {

            steps {

                script {

                    env.CURRENT_COLOR = 'unknown'
                    env.TARGET_COLOR = 'unknown'
                    env.SMOKE_TEST_FAILED = 'false'
                    env.ROLLBACK_PERFORMED = 'false'

                    echo '=============================================='
                    echo 'INITIALIZE BLUE/GREEN STATE'
                    echo '=============================================='

                    echo "CURRENT_COLOR=${env.CURRENT_COLOR}"
                    echo "TARGET_COLOR=${env.TARGET_COLOR}"
                }
            }
        }


        // ============================================================
        // AWS LOGIN
        // ============================================================

        stage('AWS Login') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-terraform-user'
                    ]
                ]) {

                    sh '''
                        set -e

                        echo "=============================================="
                        echo "AWS LOGIN"
                        echo "=============================================="

                        aws sts get-caller-identity

                        echo ""
                        echo "Configuring EKS kubeconfig..."

                        aws eks update-kubeconfig \
                            --region "${AWS_REGION}" \
                            --name "${EKS_CLUSTER}"

                        echo ""
                        echo "EKS context:"

                        kubectl config current-context

                        echo ""
                        echo "Cluster connectivity:"

                        kubectl cluster-info
                    '''
                }
            }
        }


        // ============================================================
        // BUILD USER-SERVICE IMAGE
        // ============================================================

        stage('Build user-service Image') {

            steps {

                sh '''
                    set -e

                    echo "=============================================="
                    echo "BUILD USER-SERVICE IMAGE"
                    echo "=============================================="

                    echo "Image:"
                    echo "${ECR_REGISTRY}/${USER_IMAGE}:${BUILD_NUMBER}"

                    docker build \
                        -t "${ECR_REGISTRY}/${USER_IMAGE}:${BUILD_NUMBER}" \
                        ./user-service

                    echo ""
                    echo "Docker image built successfully."

                    docker images \
                        "${ECR_REGISTRY}/${USER_IMAGE}" \
                        --format "table {{.Repository}}\\t{{.Tag}}\\t{{.ID}}\\t{{.Size}}"
                '''
            }
        }


        // ============================================================
        // PUSH USER-SERVICE IMAGE
        // ============================================================

        stage('Push user-service Image') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-terraform-user'
                    ]
                ]) {

                    sh '''
                        set -e

                        echo "=============================================="
                        echo "PUSH USER-SERVICE IMAGE"
                        echo "=============================================="

                        echo "Logging into ECR..."

                        aws ecr get-login-password \
                            --region "${AWS_REGION}" |
                        docker login \
                            --username AWS \
                            --password-stdin "${ECR_REGISTRY}"

                        echo ""
                        echo "Pushing image:"

                        docker push \
                            "${ECR_REGISTRY}/${USER_IMAGE}:${BUILD_NUMBER}"

                        echo ""
                        echo "Verifying image in ECR..."

                        aws ecr describe-images \
                            --repository-name "${USER_IMAGE}" \
                            --image-ids imageTag="${BUILD_NUMBER}" \
                            --region "${AWS_REGION}"

                        echo ""
                        echo "ECR image verified successfully."
                    '''
                }
            }
        }


        // ============================================================
        // ENSURE DATABASE SECRET
        // ============================================================

        stage('Ensure Database Secret') {

            steps {

                withCredentials([

                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-terraform-user'
                    ],

                    string(
                        credentialsId: 'rds-db-password',
                        variable: 'RDS_PASSWORD'
                    )

                ]) {

                    sh '''
                        set -e

                        echo "=============================================="
                        echo "ENSURING DATABASE SECRET"
                        echo "=============================================="

                        aws sts get-caller-identity >/dev/null

                        kubectl create secret generic ecommerce-db-secret \
                            -n "${NAMESPACE}" \
                            --from-literal=POSTGRES_HOST=ecommerce-postgres.c7u8o4skoxo.ap-south-1.rds.amazonaws.com \
                            --from-literal=POSTGRES_PORT=5432 \
                            --from-literal=POSTGRES_DB=ecommerce \
                            --from-literal=POSTGRES_USER=postgres \
                            --from-literal=POSTGRES_PASSWORD="${RDS_PASSWORD}" \
                            --dry-run=client \
                            -o yaml |
                        kubectl apply -f -

                        echo ""
                        echo "Database secret status:"

                        kubectl get secret ecommerce-db-secret \
                            -n "${NAMESPACE}"

                        echo ""
                        echo "Database secret ensured successfully."
                    '''
                }
            }
        }


        // ============================================================
        // DETERMINE ACTIVE COLOR
        // ============================================================

        stage('Determine Active Color') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-terraform-user'
                    ]
                ]) {

                    script {

                        sh '''
                            set -e

                            echo "=============================================="
                            echo "DETERMINE ACTIVE COLOR"
                            echo "=============================================="

                            echo ""
                            echo "Current user-service-bg selector:"

                            kubectl get service "${USER_SERVICE_BG}" \
                                -n "${NAMESPACE}" \
                                -o jsonpath='{.spec.selector}' || true

                            echo ""
                        '''


                        def activeColor = sh(
                            script: '''
                                kubectl get service "${USER_SERVICE_BG}" \
                                    -n "${NAMESPACE}" \
                                    -o jsonpath='{.spec.selector.version}' \
                                    2>/dev/null || true
                            ''',
                            returnStdout: true
                        ).trim()


                        echo ""
                        echo "Detected service color: '${activeColor}'"


                        // ------------------------------------------------
                        // Normal Blue/Green case
                        // ------------------------------------------------

                        if (activeColor == 'blue') {

                            env.CURRENT_COLOR = 'blue'
                            env.TARGET_COLOR = 'green'

                        }

                        else if (activeColor == 'green') {

                            env.CURRENT_COLOR = 'green'
                            env.TARGET_COLOR = 'blue'

                        }

                        // ------------------------------------------------
                        // No valid selector found
                        // ------------------------------------------------

                        else {

                            echo ""
                            echo "No valid service color detected."
                            echo "Checking existing deployments..."


                            def blueExists = sh(
                                script: '''
                                    kubectl get deployment user-service-blue \
                                        -n "${NAMESPACE}" \
                                        >/dev/null 2>&1
                                ''',
                                returnStatus: true
                            )


                            def greenExists = sh(
                                script: '''
                                    kubectl get deployment user-service-green \
                                        -n "${NAMESPACE}" \
                                        >/dev/null 2>&1
                                ''',
                                returnStatus: true
                            )


                            if (blueExists == 0 && greenExists != 0) {

                                env.CURRENT_COLOR = 'blue'
                                env.TARGET_COLOR = 'green'

                            }

                            else if (greenExists == 0 && blueExists != 0) {

                                env.CURRENT_COLOR = 'green'
                                env.TARGET_COLOR = 'blue'

                            }

                            else {

                                // ------------------------------------------------
                                // Initial deployment.
                                //
                                // Blue will be the first deployment.
                                // We treat green as the "old/nonexistent"
                                // color and blue as the target.
                                // ------------------------------------------------

                                env.CURRENT_COLOR = 'green'
                                env.TARGET_COLOR = 'blue'
                            }
                        }


                        echo ""
                        echo "=============================================="
                        echo "BLUE/GREEN STATE"
                        echo "=============================================="

                        echo "Current color : ${env.CURRENT_COLOR}"
                        echo "Target color  : ${env.TARGET_COLOR}"

                        echo "=============================================="


                        // ------------------------------------------------
                        // Safety validation
                        // ------------------------------------------------

                        if (
                            env.CURRENT_COLOR == 'unknown' ||
                            env.TARGET_COLOR == 'unknown' ||
                            !env.CURRENT_COLOR ||
                            !env.TARGET_COLOR
                        ) {

                            error(
                                "Blue/Green state initialization failed. " +
                                "CURRENT_COLOR=${env.CURRENT_COLOR}, " +
                                "TARGET_COLOR=${env.TARGET_COLOR}"
                            )
                        }
                    }
                }
            }
        }


        // ============================================================
        // PREPARE TARGET BLUE/GREEN
        // ============================================================

        stage('Prepare Blue-Green') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-terraform-user'
                    ]
                ]) {

                    sh '''
                        set -e

                        echo "=============================================="
                        echo "PREPARE BLUE/GREEN"
                        echo "=============================================="

                        TARGET_DEPLOYMENT="${USER_SERVICE}-${TARGET_COLOR}"
                        TARGET_MANIFEST="k8s/${USER_SERVICE}-${TARGET_COLOR}.yaml"

                        echo "Current color       : ${CURRENT_COLOR}"
                        echo "Target color        : ${TARGET_COLOR}"
                        echo "Target deployment   : ${TARGET_DEPLOYMENT}"
                        echo "Target manifest     : ${TARGET_MANIFEST}"

                        echo ""
                        echo "Checking target manifest..."

                        test -f "${TARGET_MANIFEST}"

                        echo ""
                        echo "Checking existing target deployment..."

                        if kubectl get deployment "${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" >/dev/null 2>&1; then

                            echo "Target deployment exists."

                            kubectl scale deployment "${TARGET_DEPLOYMENT}" \
                                -n "${NAMESPACE}" \
                                --replicas=0

                        else

                            echo "Target deployment does not exist."

                        fi


                        echo ""
                        echo "Applying target deployment manifest..."

                        kubectl apply \
                            -f "${TARGET_MANIFEST}"


                        echo ""
                        echo "Updating image..."

                        kubectl set image deployment/"${TARGET_DEPLOYMENT}" \
                            user-service="${ECR_REGISTRY}/${USER_IMAGE}:${BUILD_NUMBER}" \
                            -n "${NAMESPACE}"


                        echo ""
                        echo "Forcing imagePullPolicy=Always..."

                        kubectl patch deployment "${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            --type='strategic' \
                            -p='{"spec":{"template":{"spec":{"containers":[{"name":"user-service","imagePullPolicy":"Always"}]}}}}'


                        echo ""
                        echo "Scaling target color to 1 replica..."

                        kubectl scale deployment "${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            --replicas=1


                        echo ""
                        echo "Target deployment prepared."
                    '''
                }
            }
        }


        // ============================================================
        // WAIT FOR TARGET
        // ============================================================

        stage('Wait for Target') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-terraform-user'
                    ]
                ]) {

                    sh '''
                        set -e

                        echo "=============================================="
                        echo "WAIT FOR TARGET"
                        echo "=============================================="

                        TARGET_DEPLOYMENT="${USER_SERVICE}-${TARGET_COLOR}"

                        echo "Waiting for rollout:"
                        echo "${TARGET_DEPLOYMENT}"


                        kubectl rollout status \
                            deployment/"${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            --timeout=300s


                        echo ""
                        echo "Target deployment status:"

                        kubectl get deployment "${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            -o wide


                        echo ""
                        echo "Target pods:"

                        kubectl get pods \
                            -n "${NAMESPACE}" \
                            -l "app=${USER_SERVICE},version=${TARGET_COLOR}" \
                            -o wide


                        echo ""
                        echo "Waiting for Available condition..."

                        kubectl wait \
                            --for=condition=Available \
                            deployment/"${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            --timeout=120s


                        echo ""
                        echo "Target color is ready."
                    '''
                }
            }
        }


        // ============================================================
        // SWITCH TRAFFIC
        // ============================================================

        stage('Switch Traffic') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-terraform-user'
                    ]
                ]) {

                    sh '''
                        set -e

                        echo "=============================================="
                        echo "SWITCH TRAFFIC"
                        echo "=============================================="

                        echo "Switching ${USER_SERVICE_BG}"
                        echo "from ${CURRENT_COLOR}"
                        echo "to   ${TARGET_COLOR}"


                        kubectl patch service "${USER_SERVICE_BG}" \
                            -n "${NAMESPACE}" \
                            --type='merge' \
                            -p "{\"spec\":{\"selector\":{\"app\":\"${USER_SERVICE}\",\"version\":\"${TARGET_COLOR}\"}}}"


                        echo ""
                        echo "New service selector:"

                        kubectl get service "${USER_SERVICE_BG}" \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.selector}'


                        echo ""
                        echo ""

                        echo "Traffic successfully switched to ${TARGET_COLOR}."
                    '''
                }
            }
        }


        // ============================================================
        // APPLY CPU-ONLY HPA
        // ============================================================

        stage('Apply CPU-only HPA') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-terraform-user'
                    ]
                ]) {

                    sh '''
                        set -e

                        echo "=============================================="
                        echo "APPLY CPU-ONLY HPA"
                        echo "=============================================="

                        TARGET_DEPLOYMENT="${USER_SERVICE}-${TARGET_COLOR}"


                        cat > /tmp/user-service-hpa.yaml <<EOF
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: user-service-hpa
  namespace: ${NAMESPACE}
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: ${TARGET_DEPLOYMENT}

  minReplicas: 1
  maxReplicas: 2

  behavior:
    scaleUp:
      stabilizationWindowSeconds: 0
      selectPolicy: Max
      policies:
        - type: Percent
          value: 100
          periodSeconds: 60

    scaleDown:
      stabilizationWindowSeconds: 300
      selectPolicy: Max
      policies:
        - type: Percent
          value: 50
          periodSeconds: 60

  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70
EOF


                        kubectl apply \
                            -f /tmp/user-service-hpa.yaml


                        echo ""
                        echo "HPA applied."


                        echo ""
                        echo "HPA details:"

                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o wide


                        echo ""
                        echo "HPA target:"

                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.scaleTargetRef.name}'


                        echo ""
                        echo ""


                        echo "HPA metrics:"

                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.metrics}'


                        echo ""
                    '''
                }
            }
        }


        // ============================================================
        // SMOKE TEST
        // ============================================================

        stage('Smoke Test') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-terraform-user'
                    ]
                ]) {

                    script {

                        def smokeResult = sh(
                            script: '''
                                set +e

                                echo "=============================================="
                                echo "SMOKE TEST"
                                echo "=============================================="


                                TARGET_DEPLOYMENT="${USER_SERVICE}-${TARGET_COLOR}"


                                echo "Testing deployment:"
                                echo "${TARGET_DEPLOYMENT}"


                                POD_NAME=$(kubectl get pods \
                                    -n "${NAMESPACE}" \
                                    -l "app=${USER_SERVICE},version=${TARGET_COLOR}" \
                                    -o jsonpath='{.items[0].metadata.name}' \
                                    2>/dev/null)


                                if [ -z "${POD_NAME}" ]; then

                                    echo ""
                                    echo "SMOKE TEST FAILED"
                                    echo "No target pod found."

                                    exit 1
                                fi


                                echo ""
                                echo "Target pod:"
                                echo "${POD_NAME}"


                                echo ""
                                echo "Pod status:"

                                kubectl get pod "${POD_NAME}" \
                                    -n "${NAMESPACE}" \
                                    -o wide


                                echo ""
                                echo "Checking pod readiness..."


                                READY=$(kubectl get pod "${POD_NAME}" \
                                    -n "${NAMESPACE}" \
                                    -o jsonpath='{.status.containerStatuses[0].ready}' \
                                    2>/dev/null)


                                if [ "${READY}" != "true" ]; then

                                    echo ""
                                    echo "SMOKE TEST FAILED"
                                    echo "Container is not ready."

                                    exit 1
                                fi


                                echo "Container is Ready."


                                echo ""
                                echo "Checking user-service endpoint..."


                                TEST_PASSED="false"


                                for ENDPOINT in "/health" "/healthz" "/"; do

                                    echo ""
                                    echo "Testing ${ENDPOINT}..."


                                    kubectl exec \
                                        "${POD_NAME}" \
                                        -n "${NAMESPACE}" \
                                        -- sh -c \
                                        "curl -fsS --max-time 10 http://127.0.0.1:8001${ENDPOINT} >/dev/null" \
                                        2>/dev/null


                                    if [ $? -eq 0 ]; then

                                        echo "Endpoint ${ENDPOINT} passed."

                                        TEST_PASSED="true"

                                        break
                                    fi

                                done


                                if [ "${TEST_PASSED}" != "true" ]; then

                                    echo ""
                                    echo "SMOKE TEST FAILED"
                                    echo "No health endpoint responded successfully."


                                    echo ""
                                    echo "Recent pod logs:"

                                    kubectl logs "${POD_NAME}" \
                                        -n "${NAMESPACE}" \
                                        --tail=100 || true


                                    exit 1
                                fi


                                echo ""
                                echo "=============================================="
                                echo "SMOKE TEST PASSED"
                                echo "=============================================="


                                exit 0
                            ''',
                            returnStatus: true
                        )


                        if (smokeResult != 0) {

                            env.SMOKE_TEST_FAILED = 'true'

                            echo ""
                            echo "=============================================="
                            echo "SMOKE TEST FAILED"
                            echo "=============================================="

                            echo ""
                            echo "Automatic rollback will now be attempted."

                        }

                        else {

                            env.SMOKE_TEST_FAILED = 'false'

                            echo ""
                            echo "Smoke test passed."
                        }
                    }
                }
            }
        }


        // ============================================================
        // ROLLBACK IF SMOKE TEST FAILED
        // ============================================================

        stage('Rollback on Failure') {

            when {
                expression {
                    return env.SMOKE_TEST_FAILED == 'true'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-terraform-user'
                    ]
                ]) {

                    script {

                        def rollbackResult = sh(
                            script: '''
                                set -e

                                echo "=============================================="
                                echo "AUTOMATIC ROLLBACK"
                                echo "=============================================="


                                OLD_DEPLOYMENT="${USER_SERVICE}-${CURRENT_COLOR}"
                                FAILED_DEPLOYMENT="${USER_SERVICE}-${TARGET_COLOR}"


                                echo "Previous color : ${CURRENT_COLOR}"
                                echo "Failed color   : ${TARGET_COLOR}"


                                echo ""
                                echo "Restoring traffic to ${CURRENT_COLOR}..."


                                kubectl patch service "${USER_SERVICE_BG}" \
                                    -n "${NAMESPACE}" \
                                    --type='merge' \
                                    -p "{\"spec\":{\"selector\":{\"app\":\"${USER_SERVICE}\",\"version\":\"${CURRENT_COLOR}\"}}}"


                                echo ""
                                echo "Traffic restored."


                                echo ""
                                echo "Restoring HPA target..."


                                if kubectl get deployment "${OLD_DEPLOYMENT}" \
                                    -n "${NAMESPACE}" >/dev/null 2>&1; then


                                    kubectl patch hpa user-service-hpa \
                                        -n "${NAMESPACE}" \
                                        --type='merge' \
                                        -p "{\"spec\":{\"scaleTargetRef\":{\"apiVersion\":\"apps/v1\",\"kind\":\"Deployment\",\"name\":\"${OLD_DEPLOYMENT}\"}}}"


                                    echo "HPA target restored to ${OLD_DEPLOYMENT}."

                                else

                                    echo "Previous deployment ${OLD_DEPLOYMENT} does not exist."

                                fi


                                echo ""
                                echo "Scaling failed color to 0..."


                                if kubectl get deployment "${FAILED_DEPLOYMENT}" \
                                    -n "${NAMESPACE}" >/dev/null 2>&1; then


                                    kubectl scale deployment "${FAILED_DEPLOYMENT}" \
                                        -n "${NAMESPACE}" \
                                        --replicas=0

                                else

                                    echo "Failed deployment does not exist."

                                fi


                                echo ""
                                echo "Verifying service selector..."


                                kubectl get service "${USER_SERVICE_BG}" \
                                    -n "${NAMESPACE}" \
                                    -o jsonpath='{.spec.selector}'


                                echo ""
                                echo ""


                                echo "Verifying HPA..."


                                kubectl get hpa user-service-hpa \
                                    -n "${NAMESPACE}" \
                                    -o wide


                                echo ""
                                echo "Verifying deployments..."


                                kubectl get deployment \
                                    -n "${NAMESPACE}" \
                                    -l "app=${USER_SERVICE}" \
                                    -o wide


                                echo ""
                                echo "=============================================="
                                echo "ROLLBACK SUCCESSFUL"
                                echo "=============================================="


                                exit 0
                            ''',
                            returnStatus: true
                        )


                        if (rollbackResult == 0) {

                            env.ROLLBACK_PERFORMED = 'true'

                            echo ""
                            echo "Rollback completed successfully."
                            echo "The failed target color has been deactivated."

                        }

                        else {

                            env.ROLLBACK_PERFORMED = 'false'

                            error(
                                "AUTOMATIC ROLLBACK FAILED. " +
                                "Manual intervention is required."
                            )
                        }
                    }
                }
            }
        }


        // ============================================================
        // DEACTIVATE OLD COLOR
        // ============================================================

        stage('Deactivate Old Color') {

            when {
                expression {
                    return env.SMOKE_TEST_FAILED != 'true'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-terraform-user'
                    ]
                ]) {

                    sh '''
                        set -e

                        echo "=============================================="
                        echo "DEACTIVATE OLD COLOR"
                        echo "=============================================="


                        OLD_DEPLOYMENT="${USER_SERVICE}-${CURRENT_COLOR}"


                        echo "Current active color : ${CURRENT_COLOR}"
                        echo "New active color     : ${TARGET_COLOR}"
                        echo "Old deployment       : ${OLD_DEPLOYMENT}"


                        if kubectl get deployment "${OLD_DEPLOYMENT}" \
                            -n "${NAMESPACE}" >/dev/null 2>&1; then


                            echo ""
                            echo "Scaling old deployment to 0..."


                            kubectl scale deployment "${OLD_DEPLOYMENT}" \
                                -n "${NAMESPACE}" \
                                --replicas=0


                            echo ""
                            echo "Old deployment scaled down."

                        else

                            echo ""
                            echo "Old deployment does not exist."
                            echo "Nothing to deactivate."

                        fi


                        echo ""
                        echo "Current user-service deployments:"


                        kubectl get deployment \
                            -n "${NAMESPACE}" \
                            -l "app=${USER_SERVICE}" \
                            -o wide


                        echo ""
                        echo "Old color deactivation complete."
                    '''
                }
            }
        }


        // ============================================================
        // FINAL HEALTH CHECKS
        // ============================================================

        stage('Final Health Checks') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-terraform-user'
                    ]
                ]) {

                    sh '''
                        set -e

                        echo "=============================================="
                        echo "FINAL HEALTH CHECKS"
                        echo "=============================================="


                        echo ""
                        echo "Service selector:"


                        kubectl get service "${USER_SERVICE_BG}" \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.selector}'


                        echo ""
                        echo ""


                        echo "Deployments:"


                        kubectl get deployment \
                            -n "${NAMESPACE}" \
                            -l "app=${USER_SERVICE}" \
                            -o wide


                        echo ""
                        echo "Pods:"


                        kubectl get pods \
                            -n "${NAMESPACE}" \
                            -l "app=${USER_SERVICE}" \
                            -o wide


                        echo ""
                        echo "HPA:"


                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o wide


                        echo ""
                        echo "HPA target:"


                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.scaleTargetRef.name}'


                        echo ""
                        echo ""


                        echo "HPA metric:"


                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.metrics}'


                        echo ""
                        echo ""


                        echo "Final health checks complete."
                    '''
                }
            }
        }


        // ============================================================
        // DEPLOYMENT SUMMARY
        // ============================================================

        stage('Deployment Summary') {

            steps {

                echo ''
                echo '=============================================='
                echo 'DEPLOYMENT SUMMARY'
                echo '=============================================='


                echo "Build number       : ${BUILD_NUMBER}"
                echo "Image tag          : ${BUILD_NUMBER}"
                echo "Service            : user-service"
                echo "Current color      : ${CURRENT_COLOR}"
                echo "Target color       : ${TARGET_COLOR}"
                echo "Smoke test failed  : ${SMOKE_TEST_FAILED}"
                echo "Rollback performed : ${ROLLBACK_PERFORMED}"


                echo ''
                echo 'Other services:'


                echo 'product-service   -> SKIPPED'
                echo 'cart-service      -> SKIPPED'
                echo 'order-service     -> SKIPPED'
                echo 'payment-service   -> SKIPPED'
                echo 'inventory-service -> SKIPPED'


                echo ''
                echo 'CPU-only HPA:'


                echo 'Min replicas      : 1'
                echo 'Max replicas      : 2'
                echo 'CPU target        : 70%'


                echo ''
                echo '=============================================='
                echo 'USER-SERVICE DEPLOYMENT COMPLETE'
                echo '=============================================='
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''
            echo '=============================================='
            echo 'JENKINS BUILD SUCCESS'
            echo '=============================================='


            script {

                if (env.ROLLBACK_PERFORMED == 'true') {

                    echo ''
                    echo 'NOTE:'
                    echo 'The new color failed the smoke test.'
                    echo 'Automatic rollback succeeded.'
                    echo 'Traffic was restored to the previous color.'
                    echo 'The failed color was scaled to 0.'
                    echo 'Therefore the Jenkins build is SUCCESSFUL.'
                }
            }
        }


        failure {

            echo ''
            echo '=============================================='
            echo 'JENKINS BUILD FAILED'
            echo '=============================================='


            script {

                if (
                    env.SMOKE_TEST_FAILED == 'true' &&
                    env.ROLLBACK_PERFORMED != 'true'
                ) {

                    echo ''
                    echo 'WARNING:'
                    echo 'Smoke test failed and automatic rollback'
                    echo 'did not complete successfully.'
                    echo 'Manual Kubernetes intervention is required.'
                }
            }
        }


        always {

            echo ''
            echo '=============================================='
            echo 'PIPELINE FINISHED'
            echo '=============================================='
        }
    }
}
