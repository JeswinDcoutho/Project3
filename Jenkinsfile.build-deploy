pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        AWS_REGION        = 'ap-south-1'
        AWS_DEFAULT_REGION = 'ap-south-1'
        AWS_ACCOUNT       = '777000838263'

        ECR_REGISTRY      = '777000838263.dkr.ecr.ap-south-1.amazonaws.com'
        EKS_CLUSTER       = 'ecommerce-eks'
        NAMESPACE         = 'nodejs-devops'

        USER_SERVICE      = 'user-service'
        USER_REPO         = 'ecommerce-user-service'

        IMAGE_TAG         = "${BUILD_NUMBER}"

        GIT_REPO          = 'https://github.com/JeswinDcoutho/Project3.git'
        GIT_BRANCH        = 'master'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "*/${GIT_BRANCH}"]],
                    doGenerateSubmoduleConfigurations: false,
                    extensions: [],
                    userRemoteConfigs: [[
                        credentialsId: 'github',
                        url: "${GIT_REPO}"
                    ]]
                ])

                sh '''
                    set -e

                    echo "=============================================="
                    echo "USER-SERVICE ONLY BLUE/GREEN PIPELINE"
                    echo "=============================================="
                    echo "Jenkins build : ${BUILD_NUMBER}"
                    echo "Image tag     : ${IMAGE_TAG}"
                    echo "Git branch    : ${GIT_BRANCH}"
                    echo "Git commit    : $(git rev-parse --short HEAD)"
                    echo "=============================================="
                '''
            }
        }


        stage('AWS Login') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "AWS AUTHENTICATION"
                        echo "=============================================="

                        echo "AWS identity:"
                        aws sts get-caller-identity

                        echo
                        echo "Configuring EKS kubeconfig..."

                        aws eks update-kubeconfig \
                          --name "${EKS_CLUSTER}" \
                          --region "${AWS_REGION}"

                        echo
                        echo "EKS context:"
                        kubectl config current-context

                        echo
                        echo "Checking namespace:"
                        kubectl get namespace "${NAMESPACE}"

                        echo
                        echo "Logging in to ECR..."

                        aws ecr get-login-password \
                          --region "${AWS_REGION}" | \
                          docker login \
                          --username AWS \
                          --password-stdin "${ECR_REGISTRY}"

                        echo
                        echo "AWS / EKS / ECR authentication successful."
                    '''
                }
            }
        }


        stage('Build user-service Image') {
            steps {
                sh '''
                    set -e

                    echo "=============================================="
                    echo "BUILDING USER-SERVICE ONLY"
                    echo "=============================================="

                    docker build \
                      -t "${ECR_REGISTRY}/${USER_REPO}:${IMAGE_TAG}" \
                      ./user-service

                    echo
                    echo "Docker image created:"

                    docker images \
                      "${ECR_REGISTRY}/${USER_REPO}:${IMAGE_TAG}"
                '''
            }
        }


        stage('Push user-service Image') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "PUSHING USER-SERVICE ONLY"
                        echo "=============================================="

                        echo "Repository : ${USER_REPO}"
                        echo "Image tag  : ${IMAGE_TAG}"

                        docker push \
                          "${ECR_REGISTRY}/${USER_REPO}:${IMAGE_TAG}"

                        echo
                        echo "Verifying ECR image..."

                        aws ecr describe-images \
                          --repository-name "${USER_REPO}" \
                          --image-ids imageTag="${IMAGE_TAG}" \
                          --region "${AWS_REGION}" \
                          --query 'imageDetails[0].{tag:imageTags[0],digest:imageDigest}' \
                          --output table

                        echo
                        echo "ECR verification successful."
                    '''
                }
            }
        }


        stage('Ensure Database Secret') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user'],

                    string(
                        credentialsId: 'rds-db-password',
                        variable: 'RDS_DB_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "ENSURING DATABASE SECRET"
                        echo "=============================================="

                        kubectl create secret generic ecommerce-db-secret \
                          -n "${NAMESPACE}" \
                          --from-literal=POSTGRES_USER='ecommerce' \
                          --from-literal=POSTGRES_PASSWORD="$RDS_DB_PASSWORD" \
                          --dry-run=client \
                          -o yaml | \
                        kubectl apply -f -

                        echo "Database secret is ready."
                    '''
                }
            }
        }


        stage('Determine Active Color') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    script {
                        def activeColor = sh(
                            script: '''
                                set -e

                                kubectl get service user-service-bg \
                                  -n "${NAMESPACE}" \
                                  -o jsonpath='{.spec.selector.version}'
                            ''',
                            returnStdout: true
                        ).trim()

                        if (activeColor != 'blue' && activeColor != 'green') {
                            error(
                                "Unable to determine active user-service color: '${activeColor}'"
                            )
                        }

                        def targetColor =
                            (activeColor == 'blue') ? 'green' : 'blue'

                        env.CURRENT_COLOR = activeColor
                        env.TARGET_COLOR  = targetColor

                        echo "=============================================="
                        echo "BLUE/GREEN COLOR DECISION"
                        echo "=============================================="
                        echo "Current color : ${env.CURRENT_COLOR}"
                        echo "Target color  : ${env.TARGET_COLOR}"
                        echo "=============================================="
                    }
                }
            }
        }


        stage('Prepare Blue-Green Target') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        TARGET_DEPLOYMENT="user-service-${TARGET_COLOR}"
                        TARGET_MANIFEST="k8s/user-service-${TARGET_COLOR}.yaml"

                        echo "=============================================="
                        echo "PREPARING BLUE/GREEN TARGET"
                        echo "=============================================="
                        echo "Current color : ${CURRENT_COLOR}"
                        echo "Target color  : ${TARGET_COLOR}"
                        echo "Deployment    : ${TARGET_DEPLOYMENT}"
                        echo "Manifest      : ${TARGET_MANIFEST}"
                        echo "Image         : ${ECR_REGISTRY}/${USER_REPO}:${IMAGE_TAG}"
                        echo "=============================================="

                        echo
                        echo "Checking whether target deployment exists..."

                        if kubectl get deployment "${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" >/dev/null 2>&1; then

                            echo "Target deployment exists."
                            echo "Scaling it to zero before update..."

                            kubectl scale deployment "${TARGET_DEPLOYMENT}" \
                              -n "${NAMESPACE}" \
                              --replicas=0
                        else
                            echo "Target deployment does not exist."
                        fi

                        echo
                        echo "Applying target manifest..."

                        kubectl apply \
                          -f "${TARGET_MANIFEST}" \
                          -n "${NAMESPACE}"

                        echo
                        echo "Setting image..."

                        kubectl set image \
                          deployment/"${TARGET_DEPLOYMENT}" \
                          "${USER_SERVICE}=${ECR_REGISTRY}/${USER_REPO}:${IMAGE_TAG}" \
                          -n "${NAMESPACE}"

                        echo
                        echo "Scaling target to one replica..."

                        kubectl scale deployment "${TARGET_DEPLOYMENT}" \
                          -n "${NAMESPACE}" \
                          --replicas=1

                        echo
                        echo "Target deployment:"

                        kubectl get deployment "${TARGET_DEPLOYMENT}" \
                          -n "${NAMESPACE}" \
                          -o wide
                    '''
                }
            }
        }


        stage('Wait for Target') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        TARGET_DEPLOYMENT="user-service-${TARGET_COLOR}"

                        echo "=============================================="
                        echo "WAITING FOR TARGET"
                        echo "=============================================="

                        kubectl rollout status \
                          deployment/"${TARGET_DEPLOYMENT}" \
                          -n "${NAMESPACE}" \
                          --timeout=5m

                        echo
                        echo "Target rollout successful."

                        echo
                        echo "Target pods:"

                        kubectl get pods \
                          -n "${NAMESPACE}" \
                          -l "app=user-service,version=${TARGET_COLOR}" \
                          -o wide

                        echo
                        echo "Target deployment:"

                        kubectl get deployment "${TARGET_DEPLOYMENT}" \
                          -n "${NAMESPACE}" \
                          -o wide
                    '''
                }
            }
        }


        stage('Switch Traffic') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "SWITCHING BLUE/GREEN TRAFFIC"
                        echo "=============================================="

                        echo "Traffic:"
                        echo "  ${CURRENT_COLOR} -> ${TARGET_COLOR}"

                        cat > /tmp/user-service-bg-patch.json <<PATCH
{
  "spec": {
    "selector": {
      "app": "user-service",
      "version": "${TARGET_COLOR}"
    }
  }
}
PATCH

                        echo
                        echo "Applying service selector patch..."

                        kubectl patch service user-service-bg \
                          -n "${NAMESPACE}" \
                          --type=merge \
                          --patch-file=/tmp/user-service-bg-patch.json

                        rm -f /tmp/user-service-bg-patch.json

                        echo
                        echo "New service selector:"

                        kubectl get service user-service-bg \
                          -n "${NAMESPACE}" \
                          -o jsonpath='{.spec.selector}'

                        echo
                        echo
                        echo "Traffic successfully switched to ${TARGET_COLOR}."
                    '''
                }
            }
        }


        stage('Apply CPU-only HPA') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        TARGET_DEPLOYMENT="user-service-${TARGET_COLOR}"

                        echo "=============================================="
                        echo "APPLYING CPU-ONLY HPA"
                        echo "=============================================="

                        kubectl apply \
                          -f k8s/user-service-hpa.yaml \
                          -n "${NAMESPACE}"

                        echo
                        echo "Retargeting HPA to:"
                        echo "${TARGET_DEPLOYMENT}"

                        cat > /tmp/user-service-hpa-patch.json <<PATCH
{
  "spec": {
    "scaleTargetRef": {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "name": "${TARGET_DEPLOYMENT}"
    }
  }
}
PATCH

                        kubectl patch hpa user-service-hpa \
                          -n "${NAMESPACE}" \
                          --type=merge \
                          --patch-file=/tmp/user-service-hpa-patch.json

                        rm -f /tmp/user-service-hpa-patch.json

                        echo
                        echo "HPA:"

                        kubectl get hpa user-service-hpa \
                          -n "${NAMESPACE}" \
                          -o wide

                        echo
                        echo "HPA target:"

                        kubectl get hpa user-service-hpa \
                          -n "${NAMESPACE}" \
                          -o jsonpath='{.spec.scaleTargetRef.name}'

                        echo

                        echo
                        echo "HPA metrics:"

                        kubectl get hpa user-service-hpa \
                          -n "${NAMESPACE}" \
                          -o jsonpath='{.spec.metrics}'

                        echo
                    '''
                }
            }
        }


        stage('Deactivate Old Color') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        OLD_DEPLOYMENT="user-service-${CURRENT_COLOR}"

                        echo "=============================================="
                        echo "DEACTIVATING OLD COLOR"
                        echo "=============================================="

                        echo "Old deployment:"
                        echo "${OLD_DEPLOYMENT}"

                        echo
                        echo "Scaling old color to zero..."

                        if kubectl get deployment "${OLD_DEPLOYMENT}" \
                            -n "${NAMESPACE}" >/dev/null 2>&1; then

                            kubectl scale deployment "${OLD_DEPLOYMENT}" \
                              -n "${NAMESPACE}" \
                              --replicas=0
                        else
                            echo "Old deployment does not exist."
                        fi

                        echo
                        echo "Blue/Green deployment state:"

                        kubectl get deployment \
                          user-service-blue \
                          user-service-green \
                          -n "${NAMESPACE}" \
                          -o wide
                    '''
                }
            }
        }


        stage('Final Verification') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "FINAL USER-SERVICE VERIFICATION"
                        echo "=============================================="

                        echo
                        echo "1. Service:"

                        kubectl get service user-service-bg \
                          -n "${NAMESPACE}" \
                          -o wide

                        echo
                        echo "2. Service selector:"

                        kubectl get service user-service-bg \
                          -n "${NAMESPACE}" \
                          -o jsonpath='{.spec.selector}'

                        echo

                        echo
                        echo "3. Deployments:"

                        kubectl get deployment \
                          user-service-blue \
                          user-service-green \
                          -n "${NAMESPACE}" \
                          -o wide

                        echo
                        echo "4. Pods:"

                        kubectl get pods \
                          -n "${NAMESPACE}" \
                          -l app=user-service \
                          -o wide

                        echo
                        echo "5. HPA:"

                        kubectl get hpa user-service-hpa \
                          -n "${NAMESPACE}" \
                          -o wide

                        echo
                        echo "6. HPA target:"

                        kubectl get hpa user-service-hpa \
                          -n "${NAMESPACE}" \
                          -o jsonpath='{.spec.scaleTargetRef.name}'

                        echo

                        echo
                        echo "7. HPA metrics:"

                        kubectl get hpa user-service-hpa \
                          -n "${NAMESPACE}" \
                          -o jsonpath='{.spec.metrics}'

                        echo

                        echo
                        echo "8. Active image:"

                        kubectl get deployment \
                          "user-service-${TARGET_COLOR}" \
                          -n "${NAMESPACE}" \
                          -o jsonpath='{.spec.template.spec.containers[0].image}'

                        echo

                        echo
                        echo "=============================================="
                        echo "FINAL STATE"
                        echo "=============================================="
                        echo "Previous color : ${CURRENT_COLOR}"
                        echo "Active color   : ${TARGET_COLOR}"
                        echo "Image tag      : ${IMAGE_TAG}"
                        echo "=============================================="
                    '''
                }
            }
        }
    }


    post {

        success {
            echo """
==============================================
USER-SERVICE PIPELINE SUCCESSFUL
==============================================
Jenkins build : ${BUILD_NUMBER}
Image tag     : ${IMAGE_TAG}
Previous color: ${env.CURRENT_COLOR}
Active color  : ${env.TARGET_COLOR}

Deployment:
  user-service = Blue/Green + CPU-only HPA

Other services:
  product-service  = NOT TOUCHED
  cart-service     = NOT TOUCHED
  order-service    = NOT TOUCHED
  payment-service  = NOT TOUCHED
  inventory-service = NOT TOUCHED

Monitoring:
  Prometheus/Grafana = NOT TOUCHED
==============================================
"""
        }

        failure {
            echo """
==============================================
USER-SERVICE PIPELINE FAILED
==============================================
Jenkins build : ${BUILD_NUMBER}
Image tag     : ${IMAGE_TAG}
Current color : ${env.CURRENT_COLOR}
Target color  : ${env.TARGET_COLOR}

Check the failed stage above.
==============================================
"""
        }

        always {
            sh '''
                docker logout "${ECR_REGISTRY}" >/dev/null 2>&1 || true
                docker image prune -f >/dev/null 2>&1 || true
            '''
        }
    }
}
