pipeline {
    agent any

    environment {
        AWS_REGION          = 'ap-south-1'
        EKS_CLUSTER         = 'ecommerce-eks'
        NAMESPACE           = 'nodejs-devops'

        AWS_ACCOUNT_ID      = '777000838263'
        ECR_REGISTRY        = '777000838263.dkr.ecr.ap-south-1.amazonaws.com'
        ECR_REPOSITORY      = 'ecommerce-user-service'

        IMAGE_TAG           = "${BUILD_NUMBER}"

        CURRENT_COLOR       = 'unknown'
        TARGET_COLOR        = 'unknown'

        SMOKE_TEST_FAILED   = 'false'
        ROLLBACK_PERFORMED  = 'false'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        // ============================================================
        // 1. CHECKOUT
        // ============================================================
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/master']],
                    userRemoteConfigs: [[
                        url: 'https://github.com/JeswinDcoutho/Project3.git',
                        credentialsId: 'github'
                    ]]
                ])

                sh '''
                    echo "=============================================="
                    echo "CHECKED OUT SOURCE"
                    echo "=============================================="

                    git rev-parse --short HEAD
                    git log -1 --oneline
                '''
            }
        }


        // ============================================================
        // 2. AWS LOGIN
        // ============================================================
        stage('AWS Login') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "AWS AUTHENTICATION"
                        echo "=============================================="

                        aws sts get-caller-identity

                        echo ""
                        echo "Configuring kubeconfig..."

                        aws eks update-kubeconfig \
                            --region "${AWS_REGION}" \
                            --name "${EKS_CLUSTER}"

                        echo ""
                        echo "Checking EKS nodes..."

                        kubectl get nodes -o wide

                        echo ""
                        echo "Checking namespace..."

                        kubectl get namespace "${NAMESPACE}"

                        echo ""
                        echo "Logging into ECR..."

                        aws ecr get-login-password \
                            --region "${AWS_REGION}" | \
                        docker login \
                            --username AWS \
                            --password-stdin "${ECR_REGISTRY}"

                        echo ""
                        echo "AWS authentication completed."
                    '''
                }
            }
        }


        // ============================================================
        // 3. BUILD USER-SERVICE IMAGE
        // ============================================================
        stage('Build user-service Image') {
            steps {
                sh '''
                    set -e

                    echo "=============================================="
                    echo "BUILDING USER-SERVICE IMAGE"
                    echo "=============================================="

                    cd user-service

                    docker build \
                        -t "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}" \
                        .

                    echo ""
                    echo "Image built:"

                    docker images \
                        "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"
                '''
            }
        }


        // ============================================================
        // 4. PUSH USER-SERVICE IMAGE
        // ============================================================
        stage('Push user-service Image') {
            steps {
                /*
                 * IMPORTANT:
                 *
                 * The previous failure happened because
                 * aws ecr describe-images was executed outside
                 * the AWS credential scope.
                 *
                 * Both docker push and AWS CLI verification are
                 * now inside withCredentials.
                 */
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "PUSHING USER-SERVICE IMAGE"
                        echo "=============================================="

                        docker push \
                            "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"

                        echo ""
                        echo "Verifying image in ECR..."

                        aws ecr describe-images \
                            --repository-name "${ECR_REPOSITORY}" \
                            --image-ids imageTag="${IMAGE_TAG}" \
                            --region "${AWS_REGION}"

                        echo ""
                        echo "Image push and verification completed."
                    '''
                }
            }
        }


        // ============================================================
        // 5. ENSURE DATABASE SECRET
        // ============================================================
        stage('Ensure Database Secret') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'rds-db-password',
                        variable: 'RDS_PASSWORD'
                    ),
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "ENSURING DATABASE SECRET"
                        echo "=============================================="

                        kubectl create secret generic ecommerce-db-secret \
                            -n "${NAMESPACE}" \
                            --from-literal=POSTGRES_HOST='ecommerce-postgres.c7u8o4skoxo.ap-south-1.rds.amazonaws.com' \
                            --from-literal=POSTGRES_PORT='5432' \
                            --from-literal=POSTGRES_DB='ecommerce' \
                            --from-literal=POSTGRES_USER='postgres' \
                            --from-literal=POSTGRES_PASSWORD="${RDS_PASSWORD}" \
                            --dry-run=client \
                            -o yaml | kubectl apply -f -

                        echo ""
                        echo "Database secret status:"

                        kubectl get secret ecommerce-db-secret \
                            -n "${NAMESPACE}"
                    '''
                }
            }
        }


        // ============================================================
        // 6. DETERMINE ACTIVE COLOR
        // ============================================================
        stage('Determine Active Color') {
            steps {
                script {

                    def detectedColor = sh(
                        script: '''
                            set -e

                            kubectl get service user-service-bg \
                                -n "${NAMESPACE}" \
                                -o go-template='{{index .spec.selector "version"}}'
                        ''',
                        returnStdout: true
                    ).trim()

                    echo "Detected color: '${detectedColor}'"

                    if (detectedColor == 'blue') {

                        env.CURRENT_COLOR = 'blue'
                        env.TARGET_COLOR  = 'green'

                    } else if (detectedColor == 'green') {

                        env.CURRENT_COLOR = 'green'
                        env.TARGET_COLOR  = 'blue'

                    } else {

                        error(
                            "Invalid or empty active color: '${detectedColor}'. " +
                            "Expected blue or green."
                        )
                    }

                    /*
                     * Extra validation prevents:
                     *
                     * user-service-unknown
                     *
                     * from reaching the deployment stage.
                     */
                    if (!env.CURRENT_COLOR ||
                        env.CURRENT_COLOR == 'unknown' ||
                        !env.TARGET_COLOR ||
                        env.TARGET_COLOR == 'unknown') {

                        error(
                            "Blue/Green color variables were not initialized correctly. " +
                            "CURRENT_COLOR='${env.CURRENT_COLOR}', " +
                            "TARGET_COLOR='${env.TARGET_COLOR}'"
                        )
                    }

                    echo ""
                    echo "=============================================="
                    echo "BLUE/GREEN COLOR SELECTION"
                    echo "=============================================="
                    echo "Current color : ${env.CURRENT_COLOR}"
                    echo "Target color  : ${env.TARGET_COLOR}"
                    echo "=============================================="
                }
            }
        }


        // ============================================================
        // 7. PREPARE BLUE/GREEN TARGET
        // ============================================================
        stage('Prepare Blue-Green Target') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "PREPARING BLUE/GREEN TARGET"
                        echo "=============================================="

                        TARGET_DEPLOYMENT="user-service-${TARGET_COLOR}"
                        TARGET_MANIFEST="k8s/user-service-${TARGET_COLOR}.yaml"

                        echo "TARGET_DEPLOYMENT=${TARGET_DEPLOYMENT}"
                        echo "TARGET_MANIFEST=${TARGET_MANIFEST}"

                        if [ ! -f "${TARGET_MANIFEST}" ]; then
                            echo ""
                            echo "ERROR: Target manifest does not exist:"
                            echo "${TARGET_MANIFEST}"
                            exit 1
                        fi

                        echo ""
                        echo "Checking existing target deployment..."

                        if kubectl get deployment "${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" >/dev/null 2>&1; then

                            echo "Existing target deployment found."

                            kubectl scale deployment "${TARGET_DEPLOYMENT}" \
                                -n "${NAMESPACE}" \
                                --replicas=0

                        else

                            echo "Target deployment does not exist."

                        fi

                        echo ""
                        echo "Applying target manifest..."

                        kubectl apply \
                            -f "${TARGET_MANIFEST}"

                        echo ""
                        echo "Updating image..."

                        kubectl set image \
                            deployment/"${TARGET_DEPLOYMENT}" \
                            user-service="${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}" \
                            -n "${NAMESPACE}"

                        echo ""
                        echo "Scaling target deployment to 1..."

                        kubectl scale deployment "${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            --replicas=1

                        echo ""
                        echo "Target deployment prepared."

                        kubectl get deployment "${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            -o wide
                    '''
                }
            }
        }


        // ============================================================
        // 8. WAIT FOR TARGET
        // ============================================================
        stage('Wait for Target') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "WAITING FOR TARGET ROLLOUT"
                        echo "=============================================="

                        TARGET_DEPLOYMENT="user-service-${TARGET_COLOR}"

                        kubectl rollout status \
                            deployment/"${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            --timeout=5m

                        echo ""
                        echo "Target pods:"

                        kubectl get pods \
                            -n "${NAMESPACE}" \
                            -l app=user-service,version="${TARGET_COLOR}" \
                            -o wide

                        echo ""
                        echo "Target rollout completed successfully."
                    '''
                }
            }
        }


        // ============================================================
        // 9. SWITCH TRAFFIC
        // ============================================================
        stage('Switch Traffic') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "SWITCHING TRAFFIC"
                        echo "=============================================="

                        echo ""
                        echo "Current service selector:"

                        kubectl get service user-service-bg \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.selector}'

                        echo ""

                        cat > /tmp/user-service-bg-patch.json <<EOF
{
  "spec": {
    "selector": {
      "app": "user-service",
      "version": "${TARGET_COLOR}"
    }
  }
}
EOF

                        kubectl patch service user-service-bg \
                            -n "${NAMESPACE}" \
                            --type=merge \
                            --patch-file=/tmp/user-service-bg-patch.json

                        echo ""
                        echo "New service selector:"

                        kubectl get service user-service-bg \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.selector}'

                        echo ""

                        ACTIVE_COLOR=$(kubectl get service user-service-bg \
                            -n "${NAMESPACE}" \
                            -o go-template='{{index .spec.selector "version"}}')

                        echo ""
                        echo "Active color after traffic switch: ${ACTIVE_COLOR}"

                        if [ "${ACTIVE_COLOR}" != "${TARGET_COLOR}" ]; then

                            echo ""
                            echo "ERROR: Traffic switch verification failed."
                            exit 1

                        fi

                        echo ""
                        echo "Traffic successfully switched to ${TARGET_COLOR}."
                    '''
                }
            }
        }


        // ============================================================
        // 10. APPLY CPU-ONLY HPA
        // ============================================================
        stage('Apply CPU-only HPA') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "APPLYING CPU-ONLY HPA"
                        echo "=============================================="

                        TARGET_DEPLOYMENT="user-service-${TARGET_COLOR}"

                        echo ""
                        echo "Applying HPA manifest..."

                        kubectl apply \
                            -f k8s/user-hpa.yaml

                        echo ""
                        echo "Retargeting HPA to:"
                        echo "${TARGET_DEPLOYMENT}"

                        cat > /tmp/user-hpa-patch.json <<EOF
{
  "spec": {
    "scaleTargetRef": {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "name": "${TARGET_DEPLOYMENT}"
    }
  }
}
EOF

                        kubectl patch hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            --type=merge \
                            --patch-file=/tmp/user-hpa-patch.json

                        echo ""
                        echo "HPA configuration:"

                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o wide

                        echo ""
                        echo "HPA target:"

                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.scaleTargetRef.name}'

                        echo ""

                        echo ""
                        echo "HPA CPU metric:"

                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.metrics[0].resource.name}'

                        echo ""

                        echo ""
                        echo "HPA target utilization:"

                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.metrics[0].resource.target.averageUtilization}'

                        echo "%"

                        echo ""
                        echo "CPU-only HPA applied successfully."
                    '''
                }
            }
        }


        // ============================================================
        // 11. SMOKE TEST ACTIVE COLOR
        // ============================================================
        stage('Smoke Test Active Color') {
            steps {
                script {

                    echo ""
                    echo "=============================================="
                    echo "SMOKE TEST ACTIVE COLOR"
                    echo "=============================================="

                    echo "Testing color: ${env.TARGET_COLOR}"

                    echo "=============================================="

                    def smokeStatus = sh(
                        script: '''
                            set +e

                            echo "Finding active user-service pod..."

                            POD=$(kubectl get pods \
                                -n "${NAMESPACE}" \
                                -l app=user-service,version="${TARGET_COLOR}" \
                                -o jsonpath='{.items[0].metadata.name}')

                            if [ -z "${POD}" ]; then
                                echo "ERROR: No active user-service pod found."
                                exit 1
                            fi

                            echo "Testing pod: ${POD}"

                            echo ""
                            echo "Calling FastAPI /docs endpoint..."

                            kubectl exec \
                                -n "${NAMESPACE}" \
                                "${POD}" \
                                -- python -c "import urllib.request; print(urllib.request.urlopen('http://127.0.0.1:8001/docs', timeout=10).status)"

                            STATUS=$?

                            echo ""
                            echo "Smoke test exit status: ${STATUS}"

                            exit ${STATUS}
                        ''',
                        returnStatus: true
                    )

                    if (smokeStatus != 0) {

                        env.SMOKE_TEST_FAILED = 'true'

                        echo """
================================================
${env.TARGET_COLOR.toUpperCase()} DID NOT PASS THE SMOKE TEST
ROLLING BACK TO ${env.CURRENT_COLOR.toUpperCase()}
================================================
"""

                    } else {

                        env.SMOKE_TEST_FAILED = 'false'

                        echo """
================================================
SMOKE TEST PASSED
ACTIVE COLOR: ${env.TARGET_COLOR.toUpperCase()}
================================================
"""
                    }
                }
            }
        }


        // ============================================================
        // 12. ROLLBACK BLUE/GREEN
        // ============================================================
        stage('Rollback Blue-Green') {
            when {
                expression {
                    env.SMOKE_TEST_FAILED == 'true'
                }
            }

            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "STARTING BLUE/GREEN ROLLBACK"
                        echo "================================================"

                        OLD_DEPLOYMENT="user-service-${CURRENT_COLOR}"
                        FAILED_DEPLOYMENT="user-service-${TARGET_COLOR}"

                        echo ""
                        echo "Previous active color : ${CURRENT_COLOR}"
                        echo "Failed target color   : ${TARGET_COLOR}"
                        echo "Old deployment        : ${OLD_DEPLOYMENT}"
                        echo "Failed deployment     : ${FAILED_DEPLOYMENT}"

                        echo ""
                        echo "------------------------------------------------"
                        echo "1. RESTORING OLD DEPLOYMENT"
                        echo "------------------------------------------------"

                        if kubectl get deployment "${OLD_DEPLOYMENT}" \
                            -n "${NAMESPACE}" >/dev/null 2>&1; then

                            kubectl scale deployment "${OLD_DEPLOYMENT}" \
                                -n "${NAMESPACE}" \
                                --replicas=1

                        else

                            echo "ERROR: Previous deployment does not exist."
                            exit 1

                        fi

                        echo ""
                        echo "Waiting for previous deployment..."

                        kubectl rollout status \
                            deployment/"${OLD_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            --timeout=5m

                        echo ""
                        echo "Previous deployment is healthy."

                        echo ""
                        echo "------------------------------------------------"
                        echo "2. RESTORING SERVICE TRAFFIC"
                        echo "------------------------------------------------"

                        cat > /tmp/user-service-bg-rollback.json <<EOF
{
  "spec": {
    "selector": {
      "app": "user-service",
      "version": "${CURRENT_COLOR}"
    }
  }
}
EOF

                        kubectl patch service user-service-bg \
                            -n "${NAMESPACE}" \
                            --type=merge \
                            --patch-file=/tmp/user-service-bg-rollback.json

                        ACTIVE_COLOR=$(kubectl get service user-service-bg \
                            -n "${NAMESPACE}" \
                            -o go-template='{{index .spec.selector "version"}}')

                        echo ""
                        echo "Service active color after rollback: ${ACTIVE_COLOR}"

                        if [ "${ACTIVE_COLOR}" != "${CURRENT_COLOR}" ]; then

                            echo ""
                            echo "ERROR: Service traffic rollback failed."
                            exit 1

                        fi

                        echo ""
                        echo "Traffic restored to ${CURRENT_COLOR}."

                        echo ""
                        echo "------------------------------------------------"
                        echo "3. RESTORING HPA TARGET"
                        echo "------------------------------------------------"

                        cat > /tmp/user-hpa-rollback.json <<EOF
{
  "spec": {
    "scaleTargetRef": {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "name": "${OLD_DEPLOYMENT}"
    }
  }
}
EOF

                        kubectl patch hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            --type=merge \
                            --patch-file=/tmp/user-hpa-rollback.json

                        HPA_TARGET=$(kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.scaleTargetRef.name}')

                        echo ""
                        echo "HPA target after rollback: ${HPA_TARGET}"

                        if [ "${HPA_TARGET}" != "${OLD_DEPLOYMENT}" ]; then

                            echo ""
                            echo "ERROR: HPA rollback failed."
                            exit 1

                        fi

                        echo ""
                        echo "HPA restored to ${OLD_DEPLOYMENT}."

                        echo ""
                        echo "------------------------------------------------"
                        echo "4. DEACTIVATING FAILED COLOR"
                        echo "------------------------------------------------"

                        if kubectl get deployment "${FAILED_DEPLOYMENT}" \
                            -n "${NAMESPACE}" >/dev/null 2>&1; then

                            kubectl scale deployment "${FAILED_DEPLOYMENT}" \
                                -n "${NAMESPACE}" \
                                --replicas=0

                            echo ""
                            echo "Failed deployment scaled to 0."

                        else

                            echo ""
                            echo "Failed deployment does not exist."

                        fi

                        echo ""
                        echo "------------------------------------------------"
                        echo "5. VERIFYING ROLLBACK"
                        echo "------------------------------------------------"

                        echo ""
                        echo "Deployments:"

                        kubectl get deployments \
                            -n "${NAMESPACE}" \
                            -l app=user-service \
                            -o wide

                        echo ""
                        echo "Pods:"

                        kubectl get pods \
                            -n "${NAMESPACE}" \
                            -l app=user-service \
                            -o wide

                        echo ""
                        echo "Service:"

                        kubectl get service user-service-bg \
                            -n "${NAMESPACE}" \
                            -o wide

                        echo ""
                        echo "HPA:"

                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o wide

                        FINAL_COLOR=$(kubectl get service user-service-bg \
                            -n "${NAMESPACE}" \
                            -o go-template='{{index .spec.selector "version"}}')

                        FINAL_HPA_TARGET=$(kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.scaleTargetRef.name}')

                        echo ""
                        echo "Final service color : ${FINAL_COLOR}"
                        echo "Final HPA target    : ${FINAL_HPA_TARGET}"

                        if [ "${FINAL_COLOR}" != "${CURRENT_COLOR}" ]; then

                            echo ""
                            echo "ERROR: Final service color is incorrect."
                            exit 1

                        fi

                        if [ "${FINAL_HPA_TARGET}" != "${OLD_DEPLOYMENT}" ]; then

                            echo ""
                            echo "ERROR: Final HPA target is incorrect."
                            exit 1

                        fi

                        echo ""
                        echo "================================================"
                        echo "ROLLBACK COMPLETED SUCCESSFULLY"
                        echo "TRAFFIC RESTORED TO ${CURRENT_COLOR}"
                        echo "HPA RESTORED TO ${OLD_DEPLOYMENT}"
                        echo "${FAILED_DEPLOYMENT} SCALED TO 0"
                        echo "================================================"
                    '''

                    script {
                        env.ROLLBACK_PERFORMED = 'true'
                    }
                }
            }
        }


        // ============================================================
        // 13. FINALIZE SUCCESSFUL BLUE/GREEN DEPLOYMENT
        // ============================================================
        stage('Finalize Blue-Green Deployment') {
            when {
                expression {
                    env.SMOKE_TEST_FAILED != 'true'
                }
            }

            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "FINALIZING BLUE/GREEN DEPLOYMENT"
                        echo "=============================================="

                        OLD_DEPLOYMENT="user-service-${CURRENT_COLOR}"
                        NEW_DEPLOYMENT="user-service-${TARGET_COLOR}"

                        echo ""
                        echo "Current active color : ${CURRENT_COLOR}"
                        echo "New active color     : ${TARGET_COLOR}"

                        echo ""
                        echo "Deactivating old deployment..."

                        if kubectl get deployment "${OLD_DEPLOYMENT}" \
                            -n "${NAMESPACE}" >/dev/null 2>&1; then

                            kubectl scale deployment "${OLD_DEPLOYMENT}" \
                                -n "${NAMESPACE}" \
                                --replicas=0

                            echo "Old deployment scaled to 0."

                        else

                            echo "Old deployment does not exist."

                        fi

                        echo ""
                        echo "Active deployment:"

                        kubectl get deployment "${NEW_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            -o wide

                        echo ""
                        echo "All user-service deployments:"

                        kubectl get deployments \
                            -n "${NAMESPACE}" \
                            -l app=user-service \
                            -o wide
                    '''
                }
            }
        }


        // ============================================================
        // 14. FINAL VERIFICATION
        // ============================================================
        stage('Final Verification') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "FINAL BLUE/GREEN VERIFICATION"
                        echo "================================================"

                        if [ "${SMOKE_TEST_FAILED}" = "true" ]; then

                            EXPECTED_COLOR="${CURRENT_COLOR}"
                            EXPECTED_DEPLOYMENT="user-service-${CURRENT_COLOR}"

                        else

                            EXPECTED_COLOR="${TARGET_COLOR}"
                            EXPECTED_DEPLOYMENT="user-service-${TARGET_COLOR}"

                        fi

                        echo ""
                        echo "Expected active color    : ${EXPECTED_COLOR}"
                        echo "Expected HPA deployment : ${EXPECTED_DEPLOYMENT}"

                        echo ""
                        echo "------------------------------------------------"
                        echo "SERVICE"
                        echo "------------------------------------------------"

                        kubectl get service user-service-bg \
                            -n "${NAMESPACE}" \
                            -o wide

                        ACTIVE_COLOR=$(kubectl get service user-service-bg \
                            -n "${NAMESPACE}" \
                            -o go-template='{{index .spec.selector "version"}}')

                        echo ""
                        echo "Actual active color: ${ACTIVE_COLOR}"

                        if [ "${ACTIVE_COLOR}" != "${EXPECTED_COLOR}" ]; then

                            echo ""
                            echo "ERROR: Service is pointing to unexpected color."
                            exit 1

                        fi

                        echo ""
                        echo "------------------------------------------------"
                        echo "DEPLOYMENTS"
                        echo "------------------------------------------------"

                        kubectl get deployments \
                            -n "${NAMESPACE}" \
                            -l app=user-service \
                            -o wide

                        echo ""
                        echo "------------------------------------------------"
                        echo "PODS"
                        echo "------------------------------------------------"

                        kubectl get pods \
                            -n "${NAMESPACE}" \
                            -l app=user-service \
                            -o wide

                        echo ""
                        echo "------------------------------------------------"
                        echo "HPA"
                        echo "------------------------------------------------"

                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o wide

                        HPA_TARGET=$(kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.scaleTargetRef.name}')

                        echo ""
                        echo "Actual HPA target: ${HPA_TARGET}"

                        if [ "${HPA_TARGET}" != "${EXPECTED_DEPLOYMENT}" ]; then

                            echo ""
                            echo "ERROR: HPA is pointing to unexpected deployment."
                            exit 1

                        fi

                        echo ""
                        echo "------------------------------------------------"
                        echo "HPA CPU CONFIGURATION"
                        echo "------------------------------------------------"

                        HPA_METRIC=$(kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.metrics[0].resource.name}')

                        HPA_TARGET_CPU=$(kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.metrics[0].resource.target.averageUtilization}')

                        echo "Metric             : ${HPA_METRIC}"
                        echo "Target utilization : ${HPA_TARGET_CPU}%"

                        if [ "${HPA_METRIC}" != "cpu" ]; then

                            echo ""
                            echo "ERROR: HPA is not CPU-only."
                            exit 1

                        fi

                        if [ "${HPA_TARGET_CPU}" != "70" ]; then

                            echo ""
                            echo "ERROR: HPA CPU target is not 70%."
                            exit 1

                        fi

                        echo ""
                        echo "================================================"
                        echo "FINAL VERIFICATION PASSED"
                        echo "================================================"
                    '''
                }
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================
    post {

        success {
            echo """
============================================================
JENKINS BUILD SUCCESS
============================================================

User-service deployment completed successfully.

Current color       : ${env.CURRENT_COLOR}
Target color        : ${env.TARGET_COLOR}
Smoke test failed   : ${env.SMOKE_TEST_FAILED}
Rollback performed  : ${env.ROLLBACK_PERFORMED}
Image tag           : ${env.IMAGE_TAG}

============================================================
"""
        }

        failure {
            echo """
============================================================
JENKINS BUILD FAILED
============================================================

Current color       : ${env.CURRENT_COLOR}
Target color        : ${env.TARGET_COLOR}
Smoke test failed   : ${env.SMOKE_TEST_FAILED}
Rollback performed  : ${env.ROLLBACK_PERFORMED}
Image tag           : ${env.IMAGE_TAG}

If the failure occurred during rollback, manual
investigation of the Kubernetes state is required.

============================================================
"""
        }

        always {
            sh '''
                echo ""
                echo "================================================"
                echo "CLEANUP"
                echo "================================================"

                docker logout "${ECR_REGISTRY}" || true

                docker image prune -f || true

                echo ""
                echo "Cleanup completed."
            '''
        }
    }
}

