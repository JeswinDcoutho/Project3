pipeline {

    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        AWS_REGION       = 'ap-south-1'
        EKS_CLUSTER      = 'ecommerce-eks'
        NAMESPACE        = 'nodejs-devops'

        AWS_ACCOUNT_ID   = '777000838263'
        ECR_REGISTRY     = '777000838263.dkr.ecr.ap-south-1.amazonaws.com'
        ECR_REPOSITORY   = 'ecommerce-user-service'

        IMAGE_TAG        = "${BUILD_NUMBER}"

        CURRENT_COLOR    = 'unknown'
        TARGET_COLOR     = 'unknown'

        SMOKE_TEST_FAILED = 'false'
        ROLLBACK_PERFORMED = 'false'
    }

    stages {

        // ============================================================
        // CHECKOUT
        // ============================================================

        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/master']],
                    userRemoteConfigs: [[
                        url: 'https://github.com/JeswinDcoutho/Project3.git',
                        credentialsId: 'github'
                    ]]
                ])

                sh '''
                    set -e

                    echo "=============================================="
                    echo "CHECKED OUT SOURCE"
                    echo "=============================================="

                    git rev-parse --short HEAD
                    git log -1 --oneline
                '''
            }
        }


        // ============================================================
        // AWS LOGIN
        // ============================================================

        stage('AWS Login') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "AWS AUTHENTICATION"
                        echo "=============================================="

                        aws sts get-caller-identity

                        echo ""
                        echo "Configuring kubeconfig..."

                        aws eks update-kubeconfig \
                            --region "${AWS_REGION}" \
                            --name "${EKS_CLUSTER}"

                        echo ""
                        echo "Checking EKS nodes..."

                        kubectl get nodes -o wide

                        echo ""
                        echo "Checking namespace..."

                        kubectl get namespace "${NAMESPACE}"

                        echo ""
                        echo "Logging into ECR..."

                        aws ecr get-login-password \
                            --region "${AWS_REGION}" |
                        docker login \
                            --username AWS \
                            --password-stdin "${ECR_REGISTRY}"

                        echo ""
                        echo "AWS authentication completed."
                    '''
                }
            }
        }


        // ============================================================
        // BUILD USER SERVICE ONLY
        // ============================================================

        stage('Build user-service Image') {
            steps {
                sh '''
                    set -e

                    echo "=============================================="
                    echo "BUILDING USER-SERVICE IMAGE"
                    echo "=============================================="

                    cd user-service

                    docker build \
                        -t "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}" \
                        .

                    echo ""
                    echo "Image built:"

                    docker images \
                        "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"
                '''
            }
        }


        // ============================================================
        // PUSH USER SERVICE IMAGE
        // ============================================================

        stage('Push user-service Image') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "PUSHING USER-SERVICE IMAGE"
                        echo "=============================================="

                        aws ecr get-login-password \
                            --region "${AWS_REGION}" |
                        docker login \
                            --username AWS \
                            --password-stdin "${ECR_REGISTRY}"

                        docker push \
                            "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"

                        echo ""
                        echo "Verifying image in ECR..."

                        aws ecr describe-images \
                            --repository-name "${ECR_REPOSITORY}" \
                            --image-ids imageTag="${IMAGE_TAG}" \
                            --region "${AWS_REGION}"

                        echo ""
                        echo "Image push and verification completed."
                    '''
                }
            }
        }


        // ============================================================
        // DATABASE SECRET
        // ============================================================

        stage('Ensure Database Secret') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user'],

                    string(
                        credentialsId: 'rds-db-password',
                        variable: 'RDS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "ENSURING DATABASE SECRET"
                        echo "=============================================="

                        aws sts get-caller-identity >/dev/null

                        kubectl create secret generic ecommerce-db-secret \
                            -n "${NAMESPACE}" \
                            --from-literal=POSTGRES_HOST=ecommerce-postgres.c7u8o4skoxo.ap-south-1.rds.amazonaws.com \
                            --from-literal=POSTGRES_PORT=5432 \
                            --from-literal=POSTGRES_DB=ecommerce \
                            --from-literal=POSTGRES_USER=postgres \
                            --from-literal=POSTGRES_PASSWORD="${RDS_PASSWORD}" \
                            --dry-run=client \
                            -o yaml |
                        kubectl apply -f -

                        echo ""
                        echo "Database secret status:"

                        kubectl get secret ecommerce-db-secret \
                            -n "${NAMESPACE}"
                    '''
                }
            }
        }


        // ============================================================
        // DETERMINE ACTIVE COLOR
        // ============================================================

        stage('Determine Active Color') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    script {

                        def detectedColor = sh(
                            script: '''
                                set -e

                                kubectl get service user-service-bg \
                                    -n "${NAMESPACE}" \
                                    -o go-template='{{index .spec.selector "version"}}'
                            ''',
                            returnStdout: true
                        ).trim()

                        echo "Detected color: '${detectedColor}'"

                        if (detectedColor == 'blue') {

                            env.CURRENT_COLOR = 'blue'
                            env.TARGET_COLOR  = 'green'

                        } else if (detectedColor == 'green') {

                            env.CURRENT_COLOR = 'green'
                            env.TARGET_COLOR  = 'blue'

                        } else {

                            error(
                                "Invalid or empty active color: '${detectedColor}'. " +
                                "Expected blue or green."
                            )
                        }

                        if (
                            !env.CURRENT_COLOR ||
                            env.CURRENT_COLOR == 'unknown' ||
                            !env.TARGET_COLOR ||
                            env.TARGET_COLOR == 'unknown'
                        ) {
                            error(
                                "Blue/Green variables were not initialized correctly. " +
                                "CURRENT_COLOR='${env.CURRENT_COLOR}', " +
                                "TARGET_COLOR='${env.TARGET_COLOR}'"
                            )
                        }

                        echo ""
                        echo "Current color : ${env.CURRENT_COLOR}"
                        echo "Target color  : ${env.TARGET_COLOR}"
                    }
                }
            }
        }


        // ============================================================
        // PREPARE TARGET
        // ============================================================

        stage('Prepare Blue-Green Target') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "PREPARING BLUE/GREEN TARGET"
                        echo "=============================================="

                        TARGET_DEPLOYMENT="user-service-${TARGET_COLOR}"
                        TARGET_MANIFEST="k8s/user-service-${TARGET_COLOR}.yaml"

                        echo "TARGET_DEPLOYMENT=${TARGET_DEPLOYMENT}"
                        echo "TARGET_MANIFEST=${TARGET_MANIFEST}"

                        if [ ! -f "${TARGET_MANIFEST}" ]; then
                            echo "ERROR: Target manifest does not exist:"
                            echo "${TARGET_MANIFEST}"
                            exit 1
                        fi

                        echo ""
                        echo "Checking existing target deployment..."

                        if kubectl get deployment "${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" >/dev/null 2>&1; then

                            echo "Existing target deployment found."
                            echo "Scaling it to zero before deployment..."

                            kubectl scale deployment "${TARGET_DEPLOYMENT}" \
                                -n "${NAMESPACE}" \
                                --replicas=0
                        else
                            echo "Target deployment does not exist."
                        fi

                        echo ""
                        echo "Applying target manifest..."

                        kubectl apply \
                            -f "${TARGET_MANIFEST}"

                        echo ""
                        echo "Setting image..."

                        kubectl set image \
                            deployment/"${TARGET_DEPLOYMENT}" \
                            user-service="${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}" \
                            -n "${NAMESPACE}"

                        echo ""
                        echo "Scaling target to one replica..."

                        kubectl scale deployment "${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            --replicas=1

                        echo ""
                        echo "Blue/Green target prepared."
                    '''
                }
            }
        }


        // ============================================================
        // WAIT FOR TARGET
        // ============================================================

        stage('Wait for Target') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        TARGET_DEPLOYMENT="user-service-${TARGET_COLOR}"

                        echo "=============================================="
                        echo "WAITING FOR TARGET"
                        echo "=============================================="

                        echo "Deployment:"
                        echo "${TARGET_DEPLOYMENT}"

                        kubectl rollout status \
                            deployment/"${TARGET_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            --timeout=5m

                        echo ""
                        echo "Target pods:"

                        kubectl get pods \
                            -n "${NAMESPACE}" \
                            -l app=user-service,version="${TARGET_COLOR}" \
                            -o wide

                        echo ""
                        echo "Target deployment is healthy."
                    '''
                }
            }
        }


        // ============================================================
        // SWITCH TRAFFIC
        // ============================================================

        stage('Switch Traffic') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "SWITCHING TRAFFIC"
                        echo "=============================================="

                        echo "Switching service to:"
                        echo "${TARGET_COLOR}"

                        cat > /tmp/user-service-bg-patch.json <<EOF
{
  "spec": {
    "selector": {
      "app": "user-service",
      "version": "${TARGET_COLOR}"
    }
  }
}
EOF

                        kubectl patch service user-service-bg \
                            -n "${NAMESPACE}" \
                            --type=merge \
                            --patch-file=/tmp/user-service-bg-patch.json

                        echo ""
                        echo "New service selector:"

                        kubectl get service user-service-bg \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.selector}'

                        echo ""

                        ACTIVE_COLOR=$(kubectl get service user-service-bg \
                            -n "${NAMESPACE}" \
                            -o go-template='{{index .spec.selector "version"}}')

                        if [ "${ACTIVE_COLOR}" != "${TARGET_COLOR}" ]; then
                            echo "ERROR: Traffic switch verification failed."
                            echo "Expected: ${TARGET_COLOR}"
                            echo "Actual:   ${ACTIVE_COLOR}"
                            exit 1
                        fi

                        echo "Traffic successfully switched to ${TARGET_COLOR}."
                    '''
                }
            }
        }


        // ============================================================
        // CPU ONLY HPA
        // ============================================================

        stage('Apply CPU-only HPA') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "=============================================="
                        echo "APPLYING CPU-ONLY HPA"
                        echo "=============================================="

                        TARGET_DEPLOYMENT="user-service-${TARGET_COLOR}"

                        echo "Target deployment:"
                        echo "${TARGET_DEPLOYMENT}"

                        kubectl apply \
                            -f k8s/user-hpa.yaml

                        cat > /tmp/user-hpa-patch.json <<EOF
{
  "spec": {
    "scaleTargetRef": {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "name": "${TARGET_DEPLOYMENT}"
    }
  }
}
EOF

                        kubectl patch hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            --type=merge \
                            --patch-file=/tmp/user-hpa-patch.json

                        echo ""
                        echo "HPA configuration:"

                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o wide

                        echo ""
                        echo "HPA scale target:"

                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.scaleTargetRef.name}'

                        echo ""

                        if [ "$(kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.scaleTargetRef.name}')" \
                            != "${TARGET_DEPLOYMENT}" ]; then

                            echo "ERROR: HPA is targeting the wrong deployment."
                            exit 1
                        fi

                        echo ""
                        echo "CPU-only HPA applied successfully."
                    '''
                }
            }
        }


        // ============================================================
        // SMOKE TEST
        // ============================================================

        stage('Smoke Test Active Color') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    script {

                        def smokeStatus = sh(
                            script: '''
                                set -e

                                echo "=============================================="
                                echo "SMOKE TEST ACTIVE COLOR"
                                echo "=============================================="

                                echo "Active color:"
                                echo "${TARGET_COLOR}"

                                POD=$(kubectl get pods \
                                    -n "${NAMESPACE}" \
                                    -l app=user-service,version="${TARGET_COLOR}" \
                                    -o jsonpath='{.items[0].metadata.name}')

                                if [ -z "${POD}" ]; then
                                    echo "ERROR: No active user-service pod found."
                                    exit 1
                                fi

                                echo "Testing pod:"
                                echo "${POD}"

                                STATUS=$(kubectl exec \
                                    -n "${NAMESPACE}" \
                                    "${POD}" \
                                    -- python -c \
                                    "import urllib.request; print(urllib.request.urlopen('http://127.0.0.1:8001/docs', timeout=10).status)" \
                                    | tail -1)

                                echo "HTTP status:"
                                echo "${STATUS}"

                                if [ "${STATUS}" != "200" ]; then
                                    echo "Smoke test failed."
                                    exit 1
                                fi

                                echo ""
                                echo "Smoke test passed successfully."
                            ''',
                            returnStatus: true
                        )

                        if (smokeStatus != 0) {

                            env.SMOKE_TEST_FAILED = 'true'

                            echo """
================================================
${env.TARGET_COLOR.toUpperCase()} DID NOT PASS THE SMOKE TEST
ROLLING BACK TO ${env.CURRENT_COLOR.toUpperCase()}
================================================
"""

                        } else {

                            env.SMOKE_TEST_FAILED = 'false'

                            echo """
================================================
${env.TARGET_COLOR.toUpperCase()} PASSED THE SMOKE TEST
NO ROLLBACK REQUIRED
================================================
"""
                        }
                    }
                }
            }
        }


        // ============================================================
        // ROLLBACK
        // ============================================================

        stage('Rollback Blue-Green') {

            when {
                expression {
                    env.SMOKE_TEST_FAILED == 'true'
                }
            }

            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "================================================"
                        echo "ROLLBACK BLUE/GREEN DEPLOYMENT"
                        echo "================================================"

                        OLD_DEPLOYMENT="user-service-${CURRENT_COLOR}"
                        FAILED_DEPLOYMENT="user-service-${TARGET_COLOR}"

                        echo "Restoring deployment:"
                        echo "${OLD_DEPLOYMENT}"

                        echo ""
                        echo "Scaling old deployment to one replica..."

                        if kubectl get deployment "${OLD_DEPLOYMENT}" \
                            -n "${NAMESPACE}" >/dev/null 2>&1; then

                            kubectl scale deployment "${OLD_DEPLOYMENT}" \
                                -n "${NAMESPACE}" \
                                --replicas=1
                        else
                            echo "ERROR: Old deployment does not exist."
                            exit 1
                        fi

                        echo ""
                        echo "Waiting for old deployment..."

                        kubectl rollout status \
                            deployment/"${OLD_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            --timeout=5m

                        echo ""
                        echo "Restoring Service selector..."

                        cat > /tmp/user-service-bg-rollback.json <<EOF
{
  "spec": {
    "selector": {
      "app": "user-service",
      "version": "${CURRENT_COLOR}"
    }
  }
}
EOF

                        kubectl patch service user-service-bg \
                            -n "${NAMESPACE}" \
                            --type=merge \
                            --patch-file=/tmp/user-service-bg-rollback.json

                        echo ""
                        echo "Restoring HPA target..."

                        cat > /tmp/user-hpa-rollback.json <<EOF
{
  "spec": {
    "scaleTargetRef": {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "name": "${OLD_DEPLOYMENT}"
    }
  }
}
EOF

                        kubectl patch hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            --type=merge \
                            --patch-file=/tmp/user-hpa-rollback.json

                        echo ""
                        echo "Scaling failed deployment to zero..."

                        if kubectl get deployment "${FAILED_DEPLOYMENT}" \
                            -n "${NAMESPACE}" >/dev/null 2>&1; then

                            kubectl scale deployment "${FAILED_DEPLOYMENT}" \
                                -n "${NAMESPACE}" \
                                --replicas=0
                        fi

                        echo ""
                        echo "Verifying rollback..."

                        ACTIVE_COLOR=$(kubectl get service user-service-bg \
                            -n "${NAMESPACE}" \
                            -o go-template='{{index .spec.selector "version"}}')

                        HPA_TARGET=$(kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.scaleTargetRef.name}')

                        echo "Service color : ${ACTIVE_COLOR}"
                        echo "HPA target    : ${HPA_TARGET}"

                        if [ "${ACTIVE_COLOR}" != "${CURRENT_COLOR}" ]; then
                            echo "ERROR: Service rollback verification failed."
                            exit 1
                        fi

                        if [ "${HPA_TARGET}" != "${OLD_DEPLOYMENT}" ]; then
                            echo "ERROR: HPA rollback verification failed."
                            exit 1
                        fi

                        echo ""
                        echo "Old deployment after rollback:"

                        kubectl get deployment "${OLD_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            -o wide

                        echo ""
                        echo "Failed deployment after rollback:"

                        kubectl get deployment "${FAILED_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            -o wide

                        echo ""
                        echo "================================================"
                        echo "ROLLBACK COMPLETED SUCCESSFULLY"
                        echo "TRAFFIC RESTORED TO ${CURRENT_COLOR}"
                        echo "HPA RESTORED TO ${OLD_DEPLOYMENT}"
                        echo "FAILED ${TARGET_COLOR} DEPLOYMENT SCALED TO ZERO"
                        echo "================================================"
                    '''

                    script {
                        env.ROLLBACK_PERFORMED = 'true'
                    }
                }
            }
        }


        // ============================================================
        // FINALIZE SUCCESSFUL DEPLOYMENT
        // ============================================================

        stage('Finalize Blue-Green Deployment') {

            when {
                expression {
                    env.SMOKE_TEST_FAILED != 'true'
                }
            }

            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "================================================"
                        echo "FINALIZING BLUE/GREEN DEPLOYMENT"
                        echo "================================================"

                        OLD_DEPLOYMENT="user-service-${CURRENT_COLOR}"
                        ACTIVE_DEPLOYMENT="user-service-${TARGET_COLOR}"

                        echo "Active deployment:"
                        echo "${ACTIVE_DEPLOYMENT}"

                        echo ""
                        echo "Scaling old deployment to zero..."

                        if kubectl get deployment "${OLD_DEPLOYMENT}" \
                            -n "${NAMESPACE}" >/dev/null 2>&1; then

                            kubectl scale deployment "${OLD_DEPLOYMENT}" \
                                -n "${NAMESPACE}" \
                                --replicas=0

                            echo "Old deployment scaled to zero."

                        else

                            echo "Old deployment does not exist."
                        fi

                        echo ""
                        echo "Current user-service deployments:"

                        kubectl get deployments \
                            -n "${NAMESPACE}" \
                            -l app=user-service \
                            -o wide

                        echo ""
                        echo "Successful Blue/Green deployment finalized."
                    '''
                }
            }
        }


        // ============================================================
        // FINAL VERIFICATION
        // ============================================================

        stage('Final Verification') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform-user']
                ]) {
                    sh '''
                        set -e

                        echo "================================================"
                        echo "FINAL VERIFICATION"
                        echo "================================================"

                        if [ "${SMOKE_TEST_FAILED}" = "true" ]; then

                            EXPECTED_COLOR="${CURRENT_COLOR}"
                            EXPECTED_DEPLOYMENT="user-service-${CURRENT_COLOR}"

                            echo "Deployment was rolled back."

                        else

                            EXPECTED_COLOR="${TARGET_COLOR}"
                            EXPECTED_DEPLOYMENT="user-service-${TARGET_COLOR}"

                            echo "Deployment completed successfully."
                        fi

                        echo ""
                        echo "Expected active color:"
                        echo "${EXPECTED_COLOR}"

                        echo ""
                        echo "Checking Service..."

                        ACTIVE_COLOR=$(kubectl get service user-service-bg \
                            -n "${NAMESPACE}" \
                            -o go-template='{{index .spec.selector "version"}}')

                        echo "Service active color:"
                        echo "${ACTIVE_COLOR}"

                        if [ "${ACTIVE_COLOR}" != "${EXPECTED_COLOR}" ]; then
                            echo "ERROR: Final Service verification failed."
                            exit 1
                        fi

                        echo ""
                        echo "Checking HPA..."

                        HPA_TARGET=$(kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o jsonpath='{.spec.scaleTargetRef.name}')

                        echo "HPA target:"
                        echo "${HPA_TARGET}"

                        if [ "${HPA_TARGET}" != "${EXPECTED_DEPLOYMENT}" ]; then
                            echo "ERROR: Final HPA verification failed."
                            exit 1
                        fi

                        echo ""
                        echo "Checking active deployment..."

                        kubectl get deployment "${EXPECTED_DEPLOYMENT}" \
                            -n "${NAMESPACE}" \
                            -o wide

                        echo ""
                        echo "Checking active pods..."

                        kubectl get pods \
                            -n "${NAMESPACE}" \
                            -l app=user-service,version="${EXPECTED_COLOR}" \
                            -o wide

                        echo ""
                        echo "Checking HPA configuration..."

                        kubectl get hpa user-service-hpa \
                            -n "${NAMESPACE}" \
                            -o wide

                        echo ""
                        echo "Checking Service..."

                        kubectl get service user-service-bg \
                            -n "${NAMESPACE}" \
                            -o wide

                        echo ""
                        echo "================================================"
                        echo "FINAL VERIFICATION PASSED"
                        echo "================================================"
                    '''
                }
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {
            echo """
============================================================
JENKINS BUILD SUCCESS
============================================================

Current color       : ${env.CURRENT_COLOR}
Target color        : ${env.TARGET_COLOR}
Smoke test failed   : ${env.SMOKE_TEST_FAILED}
Rollback performed  : ${env.ROLLBACK_PERFORMED}
Image tag           : ${env.IMAGE_TAG}

User-service Blue/Green deployment completed successfully.
============================================================
"""
        }

        failure {
            echo """
============================================================
JENKINS BUILD FAILED
============================================================

Current color       : ${env.CURRENT_COLOR}
Target color        : ${env.TARGET_COLOR}
Smoke test failed   : ${env.SMOKE_TEST_FAILED}
Rollback performed  : ${env.ROLLBACK_PERFORMED}
Image tag           : ${env.IMAGE_TAG}

If failure occurred during rollback, manual
investigation of Kubernetes state is required.

============================================================
"""
        }

        always {
            sh '''
                echo ""
                echo "================================================"
                echo "CLEANUP"
                echo "================================================"

                docker logout "${ECR_REGISTRY}" || true
                docker image prune -f || true

                echo ""
                echo "Cleanup completed."
            '''
        }
    }
}

